    "Clear local action checkmarks. Your music, projects and favorites stay intact. Apple's review limits are unchanged.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klar lokale handlingskontrol. din musik, projekter og favoritmer forbliver intakte. Apple's anmeldelsesgrænser er uændret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klar lokale Aktionsprüfungen. Ihre Musik, Projekte und Favoriten bleiben unbequemer. Apple-Bewertungsgrenze sind unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las marcas de acción locales claras. su música, proyectos y favoritos permanecen intactos. los límites de revisión de Apple no se cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre musique, vos projets et vos favoris restent intact.Les limites d'examen de Apple sont inchangées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiari punti di controllo delle azioni locali.La tua musica, i tuoi progetti e i tuoi preferiti rimangono intatti.I limiti di recensione di Apple sono invariati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明確な地元のアクションチェックマーク. あなたの音楽、プロジェクト、お気に入りは無効に残ります. Apple のレビュー制限は変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명확한 지역 행동 검사표.당신의 음악, 프로젝트 및 좋아하는 것은 무결합니다.Apple의 리뷰 제한은 변하지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klar lokale handlings sjekkmerker. musikk, prosjekter og favoritter forblir intakte. Apples granskingsgrenser er uendret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kijk op lokale actie-checks. uw muziek, projecten en favorieten blijven intact. Apple's review limiet is onveranderd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificações de ação locais claras. sua música, projetos e favoritos permanecem intactos. os limites da revisão da Apple estão inalterados."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klar lokal handlingskick. din musik, projekt och favoritbevar intact. Apple recensioner gränser är oförändrade."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık yerel eylem kontrol noktaları. müzik, projeler ve favori tutun. Apple'ın inceleme sınırları değişmiyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tính năng kiểm tra hành động địa phương rõ ràng. âm nhạc, dự án và yêu thích của bạn vẫn không được giữ nguyên. giới hạn đánh giá của Apple không thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清晰的当地行动检查标志. 您的音乐、项目和喜爱保持不稳定. Apple 的评论限制是无变的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清晰的當地行動檢查標誌. 您的音樂、專案和喜愛保持不穩定. Apple 的評論限制是無變的。"
          }
        }
      }
    },
