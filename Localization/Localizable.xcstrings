    "Explore the visualizer library, save your favorites, and shape the colors and motion to suit your music.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udforsk visualiseringsbiblioteket, gem dine favoritmer og forme farverne og bevægelserne til at passe din musik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entdecken Sie die Visualisierungsbibliothek, speichern Sie Ihre Lieblings und formen Sie die Farben und Bewegungen, um Ihre Musik zu passen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explora la biblioteca de visualizadores, salve sus favoritos y forma los colores y movimientos para adaptarse a su música."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Explorez la bibliothèque visualisateur, sauvez vos favoris et formez les couleurs et les mouvements pour adapter votre musique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esplora la libreria visualizzatore, salva i tuoi preferiti e forma i colori e le mosse per adattare alla tua musica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビジュアルライブラリを探索し、お気に入りを保存し、音楽に合う色や動きを形作る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시각화 도서관을 탐험하고, 좋아하는 것을 저장하고, 음악에 맞게 색상과 움직임을 형성하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Utforsk visualiseringsbiblioteket, lagre favoritter og form de fargene og bevegelsene for å passe på musikken din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontdek de visualiseribibliotheek, bespaar uw favorieten en vorm de kleuren en bewegingen om aan uw muziek te passen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore a biblioteca de visualização, salve seus favoritos e forme as cores e movimentos para se adaptar à sua música."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utforska visualiseringsbiblioteket, spara dina favoriter och forma färgerna och rörelsen för att passa din musik."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görüntüleme kütüphanesini keşfedin, en sevdiğinizleri kaydedin ve müzikinize uygun renkler ve hareketler şekillendirin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khám phá thư viện trình chiếu, lưu những người yêu thích của bạn và hình thành màu sắc và phong trào để phù hợp với âm nhạc của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "探索图书馆,保存您的喜爱,并塑造颜色和动作适合您的音乐。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "探索圖書館,儲存您的喜愛,並塑造顏色和動作適合您的音樂。"
          }
        }
      }
    },
