          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ好きな曲はありません. All music を選択して、心臓で歌を保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 좋아하는 노래가 없습니다.모든 음악을 선택한 다음 마음으로 노래를 저장합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke favoritt sanger ennå.Vilg All musikk, så lagre sanger med hjertet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
