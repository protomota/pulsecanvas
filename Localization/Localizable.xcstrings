    "Choose 1–8 bars per section on the song’s beat grid. Tail sections may be trimmed or repeated to fit the song.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg 1-8 barer pr. sektion på sangens beatnet. Tail sektioner kan trimmes eller gentages for at passe til sangen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie 1-8 Bar pro Abschnitt auf der Beat-Geschicht des Liedes aus. Die Tail-Abschnitte können geschnitten oder wiederholt werden, um das Lied zu passen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccione 1-8 barras por sección en la red de beat de la canción. las secciones de la cola pueden ser cortadas o repetidas para adaptarse a la canción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez 1 à 8 bars par section sur la grille de battement de la chanson. Les sections de tail peuvent être trimmées ou répétées pour correspondre à la chanson."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli 1-8 barre per sezione sulla rete di battito della canzone. le sezioni del taglio possono essere tagliate o ripetute per adattare alla canzone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曲のビットネットワークで1〜8バーを選択します.曲に合うために、タイルセクションを切断または繰り返すことができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노래의 벨트 네트워크에서 1~8개의 섹션을 선택합니다.곡에 맞게 꼬리 섹션이 깎거나 반복될 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg 1–8 barer per seksjon på sangens beat-nett. Tail-seksjoner kan trimmes eller gjentas for å passe til sangen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies 1-8 bars per sectie op de beatnet van het lied. Tail secties kunnen worden gesneden of herhaald om aan het lied te passen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha 1 a 8 barras por seção na rede de batimento da canção. as seções do tail podem ser cortadas ou repetidas para se adequar à música."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj 1–8 rader per sektion på låtets beat-grid. Tail sektioner kan trimmas eller upprepas för att passa låten."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şarkının hit gridinde bölüm başına 1-8 çubuk seçin. şarkıya uygun olarak gövde bölgeleri kesilebilir veya tekrarlanabilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn 1-8 thanh mỗi phần trên lưới đánh của bài hát. Các phần đệm có thể được cắt hoặc lặp lại để phù hợp với bài hát."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择歌曲的打网上每部分1至8条线,尾部部分可以切割或重复以适应歌曲。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇歌曲的打網上每部分1至8條線,尾部部分可以切割或重複以適應歌曲。"
          }
        }
      }
    },
