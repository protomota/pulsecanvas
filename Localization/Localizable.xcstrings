    "Fresh looks replace visual settings; saved favorites keep their look. Your soundtrack stays.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fresh look erstattes visuelle indstillinger; gemte favoritter holder deres udseende."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frisch ersetzt visuelle Einstellungen; gespeicherte Favoriten halten ihren Look."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El aspecto fresco sustituye las configuraciones visuales; los favoritos salvos mantienen su aspecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apparences fraîches remplacent les paramètres visuels; les favoris sauvés gardent leur look."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'aspetto fresco sostituisce le impostazioni visive; i preferiti salvati mantengono il loro aspetto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新鮮な外観は視覚設定を置き換え、保存されたファイバーは見た目を維持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신선한 외모는 시각 설정을 대체합니다; 저장 좋아하는 사람들은 그들의 모습을 유지합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fresh look erstattes av visuelle innstillinger; redde favoritter holde ut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Frisse uitstraling vervangt visuele instellingen; bewaard favorieten houden hun look. uw soundtrack blijft."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O visual fresco substitui as configurações visuais; os favoritos salvos mantêm o seu aspecto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Färskt utseende ersätter visuella inställningar; spara favoriter behåller sitt utseende."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taze görünüm görsel ayarları değiştirir; kurtarılan favori bakışlarını korur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tương tự tươi thay thế các thiết lập thị giác; người yêu thích được tiết kiệm giữ vẻ ngoài của họ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新鲜的外观取代视觉设置;保存的爱好者保持他们的外观。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新鮮的外觀取代視覺設定;儲存的愛好者保持他們的外觀。"
          }
        }
      }
    },
    "From your canvas\nto any screen.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra din kanvas til enhver skærm."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von Ihrer Kanzle bis zu jedem Bildschirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde la canva hasta cualquier pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De vos canvas à n'importe quel écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalla tua canva a qualsiasi schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのカンバからどんな画面にも"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 캔버스에서 모든 화면에."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra kanvas til hvilken som helst skjerm."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Van uw kanvas naar elk scherm."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De qualquer tela para qualquer caneta."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Från din kanvas till vilken skärm som helst."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her ekranın kanvasından her ekranın kanvasına kadar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Từ các kênh của bạn đến bất kỳ màn hình nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从你的屏幕到任何屏幕。"
          }
        },
        "zh-Hant": {
