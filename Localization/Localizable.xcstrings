    "Tail sections may be trimmed or repeated to fit the song.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjul sektioner kan trimmes eller gentages for at passe sangen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halsschnitt können geschnitten oder wiederholt werden, um das Lied zu passen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las secciones de la columna se pueden cortar o repetir para adaptarse a la canción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sections de la taille peuvent être trimmées ou répétées pour correspondre à la chanson."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sezioni della colonna vertebrale possono essere tagliate o ripetute per adattare la canzone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曲の部分は、曲に合うために切断または繰り返すことができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꼬리 섹션은 노래에 맞게 자르거나 반복 될 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Halvdelene kan trimmes eller gjentas for å passe sangen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De hals secties kunnen worden gesneden of herhaald om het lied aan te passen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As seções de coluna podem ser cortadas ou repetidas para se adequar à canção."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tail sektioner kan trimmas eller upprepas för att passa låten."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şarkıya uygun olarak boynuz bölümleri kesilebilir veya tekrarlanabilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các phần cổ có thể được cắt hoặc lặp lại để phù hợp với bài hát."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尾部部分可以切割或重复,以适应歌曲。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尾部部分可以切割或重複,以適應歌曲。"
          }
        }
      }
    },
    "Tap a song’s heart in Radio to save it here.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på en sangs hjerte i Radio for at gemme den her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie das Herz einer Lied in Radio, um sie hier zu speichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toma el corazón de una canción en Radio para salvarla aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapez le cœur d'une chanson dans la radio pour l'enregistrer ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Toccare il cuore di una canzone in Radio per salvarla qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ラジオで歌の心臓をタップして、ここに保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라디오에서 노래의 마음을 탭하여 여기서 저장합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på en sangs hjerte i Radio for å lagre den her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip het hart van een lied in de radio om het hier te redden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique no coração de uma canção na rádio para salvar aqui."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på en låt hjärta i Radio för att spara den här."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir şarkının kalbini radyoya kaydetmek için buraya tıklayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn vào trái tim của một bài hát trên Radio để lưu nó ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击广播电台的歌曲的心脏,在这里保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點選廣播電臺的歌曲的心臟,在這裡儲存。"
          }
        }
      }
    },
    "Tap a visualizer’s heart in the Library to add it here.": {
      "localizations": {
        "da": {
