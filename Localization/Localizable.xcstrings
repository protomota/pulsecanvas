            "state": "translated",
            "value": "Adder hurtigt flasher i tid med højfrekvens percussion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erklärt schnelles Blitz in der Zeit mit hoher Frequenzperkussion."
          }
        },
