    "Apply all enables strobe everywhere with the settings below.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Anvend alle giver mulighed for at stryge overalt med indstillingerne nedenfor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anwendung alle ermöglicht Strop überall mit den unten eingeführten Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplique todos permite que se deslizen en todas partes con las configuraciones a continuación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliquer tous permet de s'écraser partout avec les paramètres ci-dessous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Applicare tutti consente di strisciare ovunque con le impostazioni qui sotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてを適用すると、下の設定でどこでもストロップできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 것을 적용하면 아래의 설정으로 어디서나 ⁇ 을 허용합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply all gjør det mulig å stryke overalt med innstillingene nedenfor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply all maakt het mogelijk om overal te strobeeren met de instellingen hieronder."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplique todos permitem que a estufa seja em qualquer lugar com as configurações abaixo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Applicera alla gör att du kan ströma överallt med inställningarna nedan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şeyi uygulayın, aşağıdaki ayarlar ile her yerde çarpışma sağlar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng tất cả cho phép đập khắp nơi với các cài đặt bên dưới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用所有允许在下面的设置中随时随地冲动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用所有允許在下面的設定中隨時隨地衝動。"
          }
        }
      }
    },
