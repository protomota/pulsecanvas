    "Resolution uses the shorter canvas edge. Export saves an MP4 with the soundtrack included.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolution bruger den kortere kanvas kant. Eksport sparer en MP4 med lydtrack inkluderet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Auflösung verwendet die kürzere Kanvas-Einde. Export speichert einen MP4 mit dem Soundtrack enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La resolución utiliza el borde de canvas más corto.Exportación salva un MP4 con la banda sonora incluida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La résolution utilise la plus courte rive de canvas. l'exportation sauve un MP4 avec le son inclus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La risoluzione utilizza il margine più breve del canvas.L'esportazione salva un MP4 con la traccia audio inclusa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解像度は、より短いカンバス端を使用します. エクスポーツは、サウンドトラックが含まれているMP4を保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해상도는 짧은 캔버스 경계를 사용합니다.Export save a MP4 with the soundtrack included."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolusjonen bruker den kortere kanvas-redgen. eksporten sparer en MP4 med lydtrack inkludert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De resolutie maakt gebruik van de kortere kanvas-kijk. Export slaat een MP4 met de soundtrack inbegrepen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A resolução usa o limite de canvas mais curto. a exportação salva um MP4 com a faixa sonora incluída."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolutionsen använder den kortare kanvas kanten. Export sparar en MP4 med ljudtracket ingår."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çözünürlük daha kısa kanvas kenarı kullanır. ihracat, sesli çubuğu içeren bir MP4'ü kaydeder."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giải pháp sử dụng cạnh canvas ngắn hơn. xuất lưu một MP4 với âm thanh được bao gồm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解析使用更短的管道边缘. 出口保存了MP4与音频带。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解析使用更短的管道邊緣. 出口儲存了MP4與音訊帶。"
          }
        }
      }
    },
