    "Set every card to this length. Later cards shift to the beat grid; the last ends with the soundtrack.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Senere kortene skifter til beat grid; den sidste ender med soundtrack."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Letztere Karten wechseln auf das beat-netz; letzte endet mit der soundtrack."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Posteriormente las tarjetas se mueven a la red de beat; el último termina con la banda sonora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La carte se passe plus tard sur la grille de battement; la dernière finit avec le son."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più tardi le carte si spostano alla rete di battito; l'ultima finisce con il soundtrack."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "後でカードはビットネットに移動し、最後のカードはサウンドトラックで終了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나중에 카드는 ⁇ 트 네트워크로 이동; 마지막은 사운드 트랙으로 끝납니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Senere kortene skifter til beat grid; den siste ender med soundtrack."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Later verhuizen de kaarten naar het beatnet; de laatste eindigt met de soundtrack."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Posteriormente, as cartas se mudam para a rede de batimento; o último termina com o soundtrack."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sätt varje kort till denna längd. Senare växlar korten till beat gränsen; den sista slutar med soundtrack."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha sonra kartlar beat grid'e geçirir; son son soundtrack ile sona erer."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt mỗi thẻ cho chiều dài này. sau đó các thẻ chuyển sang lưới đánh; cuối cùng kết thúc với âm thanh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随后,卡转向打网;最后的结束与音频轨道。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨後,卡轉向打網;最後的結束與音訊軌道。"
          }
        }
      }
    },
    "Set this card’s length in bars. Later cards shift; the last ends with the soundtrack.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sæt kortets længde i barer. senere kort skifter; den sidste ender med soundtrack."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze die Länge dieser Karte in Bars. später wechseln die Karten; der letzte endet mit dem Soundtrack."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Póngase en barras la longitud de esta tarjeta.Más tarde las tarjetas cambian; el último termina con el soundtrack."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définissez la longueur de cette carte en barres. Plus tard, les cartes changent; le dernier se termine avec le son."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In seguito le carte cambiano; l'ultima termina con il soundtrack."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このカードの長さをバーに設定します 後でカードが変更されます; 最後はサウンドトラックで終了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 카드의 길이를 바로 설정합니다.다음 카드는 변경; 마지막은 사운드 트랙으로 끝납니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sette kortets lengde i barer. senere kort skift; den siste ender med soundtrack."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel de lengte van deze kaart in bars. Later kaarten veranderen; de laatste eindigt met de soundtrack."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura a comprimento desta cartão em barras.Maior mudança de cartões; o último termina com o soundtrack."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ställ kortets längd i rader. Senare kortet byter; den sista slutade med soundtrack."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kartın uzunluğunu çubuklar halinde ayarlayın. daha sonra kart değişir; son son soundtrack ile sona erer."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt chiều dài của thẻ này trong các thanh. sau đó thay đổi thẻ; cuối cùng kết thúc với âm thanh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此卡的长度设置为行,后代卡交换;最后一张结束与音频轨道。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此卡的長度設定為行,後代卡交換;最後一張結束與音訊軌道。"
          }
        }
      }
    },
