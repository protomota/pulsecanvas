    "Turn sound into moving art with PulseCanvas Studio. A few basics, then the canvas is yours.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg lyd til bevægeligt kunst med PulseCanvas Studio. Et par basik, så kanvasen er din."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umwandeln Sie das Sound in Bewegungsart mit PulseCanvas Studio. Ein paar Grundlagen, dann ist die Kanzle Ihre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertir el sonido en arte movida con PulseCanvas Studio. Algunas bases, entonces la canva es suya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertez le son en art mouvement avec PulseCanvas Studio. Quelques bases, puis la canvas est votre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertire il suono in arte di movimento con PulseCanvas Studio. Alcuni elementi di base, quindi la canvas è tua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PulseCanvas Studio で音を動く芸術に変換します. 基本的な点数は、その後、カンバスがあなたのものです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PulseCanvas Studio를 사용하여 음성을 이동 예술으로 변환하십시오. 몇 가지 기본 사항, 그 후에 캔버스는 당신의 것입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn sound into moving art with PulseCanvas Studio. Noen grunnleggende, så kanvasen er din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijder geluid naar bewegende kunst met PulseCanvas Studio. Een paar basics, dan is de kanvas uw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Converse o som em arte movimentada com PulseCanvas Studio. Alguns elementos básicos, então a canvas é sua."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Omvandla ljud till rörlig konst med PulseCanvas Studio. Några baser, då kanvas är din."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PulseCanvas Studio ile sesin hareket sanatına dönüştürün. birkaç temel, sonra kanvas sizin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển âm thanh thành nghệ thuật di chuyển với PulseCanvas Studio. Một vài nguyên tắc cơ bản, sau đó cáp là của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 PulseCanvas Studio 转换音频到移动艺术. 有几个基本,然后曲线是你的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用 PulseCanvas Studio 轉換音訊到移動藝術. 有幾個基本,然後曲線是你的。"
          }
        }
      }
    },
    "Turn strobe off everywhere and retain individual flash settings.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå strabben ud overalt og bevar individuelle flashindstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalten Sie die Stroppe überall aus und behalten Sie individuelle Flash-Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivar la barra de los ladrillos en todas partes y mantener las configuraciones flash individuales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retournez le toit partout et conservez les paramètres flash individuels."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovere la striscia ovunque e mantenere le impostazioni flash individuali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストーブをどこでも切り離し、個々のフラッシュ設定を維持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스테이프를 어디서나 끄고 개별 플래시 설정을 유지합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå av strop overalt og beholde individuelle flash-innstillinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluit de strope overal af en behoud individuele flash-instellingen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desligue a barra de fio em todos os lugares e mantenha as configurações flash individuais."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stäng av stammen överallt och behåll individuella flashinställningar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çerçeveyi her yerde kapatın ve bireysel flash ayarlarını koruyun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khởi động đệm từ khắp nơi và giữ cho các cài đặt flash cá nhân."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把天花板从任何地方切开,并保持个别的闪光设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把天花板從任何地方切開,並保持個別的閃光設定。"
          }
        }
      }
    },
