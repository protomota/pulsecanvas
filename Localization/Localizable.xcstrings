    "Sync history needs recovery before enabling iCloud. Local files and the unreadable history are preserved.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync historie kræver genopretning, før du tillader iCloud. Lokale filer og den ulesbare historie bevares."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisierung Geschichte erfordert Wiederherstellung, bevor iCloud ermöglicht. Lokale Dateien und unlesbare Geschichte werden beibehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Historia de sincronización necesita recuperación antes de permitir iCloud. Los archivos locales y la historia no leible se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync historique nécessite une récupération avant de permettre iCloud. Les fichiers locaux et l'historique inédite sont conservés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Storia di sincronizzazione richiede la ripresa prima di consentire iCloud. i file locali e la storia non leggibile sono conservati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期歴史は iCloud を有効にする前に回復する必要があります. 地元のファイルと読み取れない歴史が保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync 역사 iCloud를 사용하기 전에 복구가 필요합니다. 로컬 파일과 읽을 수없는 역사 보존됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync historie trenger gjenoppretting før du tillater iCloud. Lokale filer og den ulesbare historien er bevaret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync-historie moet worden hersteld voordat het mogelijk maakt iCloud. Lokale bestanden en de onleesbare geschiedenis worden bewaard."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "História de sincronização precisa de recuperação antes de permitir iCloud. arquivos locais e a história não lida são preservados."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkroniseringshistorik behöver återställning innan du aktiverar iCloud. Lokala filer och den okända historien bevaras."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud'yi etkinleştirmeden önce senkronizasyon geçmişi kurtarılmalıdır. yerel dosyalar ve okunamaz geçmişi saklanır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lịch sử đồng bộ cần phục hồi trước khi cho phép iCloud. Các tệp địa phương và lịch sử không thể đọc được lưu trữ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步历史需要恢复,直到允许 iCloud. 保存本地文件和不可阅读的历史。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同步歷史需要恢復,直到允許 iCloud. 儲存本地檔案和不可閱讀的歷史。"
          }
        }
      }
    },
    "Sync needs attention: %@. Local data was kept; Sync now retries.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync har brug for opmærksomhed: %@. Lokale data blev bevaret; Sync nu tilbagevirker."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync braucht Aufmerksamkeit: %@. Lokale Daten wurden beibehalten; Sync wird jetzt zurückgeführt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync necesita atención: %@. los datos locales se conservaron; Sync ahora retira."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync a besoin d'attention: %@. les données locales ont été conservées; Sync se retire maintenant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync richiede attenzione: %@. i dati locali sono stati conservati; Sync ora si ritira."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期には注意が必要: %@. 地元のデータが保存され、現在は同期が撤回されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync는 주의를 필요로합니다: %@. 로컬 데이터가 보존되었습니다; Sync 이제 회복됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync trenger oppmerksomhet: %@. Lokale data ble bevaret; Sync nå går tilbake."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync heeft aandacht nodig: %@. Lokale gegevens werden bewaard; Sync is nu teruggekeerd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync precisa de atenção: %@. dados locais foram mantidos; Sync agora retira."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync behöver uppmärksamhet: %@. Lokala data bevarades; Sync återvänder nu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync dikkat gerektirir: %@. Yerel veriler korunmuştur; Sync şimdi geri çekiliyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync cần sự chú ý: %@. dữ liệu địa phương đã được giữ lại; Sync bây giờ rút lui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步需要注意: %@. 地点数据被保存; 同步现在退出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同步需要注意: %@. 地點資料被儲存; 同步現在退出。"
          }
        }
      }
    },
