          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvegarde vos préférés, les apparences sauvées, les projets, la musique importée et les préférences dans un fichier ZIP."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva i tuoi preferiti, guardate le apparenze, progetti, musica importata e preferenze in un file ZIP."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの好きなもの、保存された外観、プロジェクト、輸入された音楽と好みを1つのZIPファイルに保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좋아하는 것, 저장된 모양, 프로젝트, 수입 음악 및 선호도를 하나의 ZIP 파일에 저장합니다.이 장치 밖에서 복사본을 유지합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spare favoritter, lagret utseende, prosjekter, importert musikk og preferanser i en ZIP-fil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Save your favorites, saved looks, projects, imported music and preferences in one ZIP file. Houd een kopie buiten dit apparaat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve seus favoritos, visualizações salvas, projetos, música importada e preferências em um arquivo ZIP."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spara dina favorit, sparade utseende, projekt, importerad musik och preferenser i en ZIP-fil."
