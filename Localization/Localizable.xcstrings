          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Folder konnte nicht geöffnet werden. Wählen Sie eine heruntergeladenen Musikfolder und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
