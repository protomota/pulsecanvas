    "Save your favorites, saved looks, projects, imported music and preferences in one ZIP file. Keep a copy outside this device.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spare dine favoritmer, gemte udseende, projekter, importeret musik og præferencer i en ZIP-fil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern Sie Ihre Lieblings, gespeicherten Aussichten, Projekte, importierter Musik und Präferenzen in einem ZIP-Datei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
