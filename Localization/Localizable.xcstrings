    "Export or restore favorites across builds and Macs. Imports keep your existing favorites.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksport eller genoprette favoritmer over bygninger og Macs. Import holder dine eksisterende favoritter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
