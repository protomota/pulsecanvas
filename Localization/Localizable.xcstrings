    "PulseCanvas Studio is free, with every feature included. Your ratings, sharing and feedback help more people discover the app and help us keep building.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "PulseCanvas Studio er gratis, med alle funktioner inkluderet. dine vurderinger, deling og feedback hjælper flere mennesker opdage appen og hjælpe os med at holde bygningen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PulseCanvas Studio ist kostenlos, mit jeder Funktion enthalten. Ihre Bewertungen, Teilen und Feedback helfen mehr Menschen die App zu entdecken und uns dabei helfen, weiterhin aufzubauen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PulseCanvas Studio es gratuito, con todas las características incluidas. sus calificaciones, compartir y comentarios ayudan a más personas a descubrir la aplicación y nos ayudan a mantener el edificio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PulseCanvas Studio est gratuit, avec toutes les fonctionnalités inclus. Vos notations, partage et commentaires aident plus de gens à découvrir l'application et nous aident à continuer à construire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "PulseCanvas Studio è gratuito, con ogni funzionalità inclusa. le tue valutazioni, condivisione e feedback aiutano più persone a scoprire l'app e ci aiutano a mantenere la costruzione."
          }
        },
        "ja": {
