    "Folder songs are copied to this Mac and loop continuously in Radio. They stay out of Studio.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder sange er kopieret til denne Mac og loop kontinuerligt i Radio. De forbliver udenfor Studio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder-Songs werden auf diesen Mac kopiert und laufen kontinuierlich in Radio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las canciones de cartón se copian a este Mac y se mueven continuamente en Radio."
          }
        },
        "fr": {
