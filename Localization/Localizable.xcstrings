    "Restore this full backup on %@. Individual PulseCanvas projects can be opened on other platforms.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gendanne denne fuld backup på %@. Individual PulseCanvas projekter kan åbnes på andre platforme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederherstellen Sie diese vollständige Backup auf %@. Individual PulseCanvas Projekte können auf anderen Plattformen geöffnet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restablecer esta copia de seguridad completa en %@. Los proyectos individuales de PulseCanvas se pueden abrir en otras plataformas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétablir cette sauvegarde complète sur %@. Les projets individuels de PulseCanvas peuvent être ouverts sur d'autres plateformes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ristrutturare questa copia di backup completa su %@. Progetti individuali PulseCanvas possono essere aperti su altre piattaforme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全バックアップを復元する %@個別 PulseCanvas プロジェクトは他のプラットフォームで開設できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 이 전체 백업을 복원합니다.개인 PulseCanvas 프로젝트는 다른 플랫폼에서 열 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne denne fullstendige sikkerhetskopien på %@. individuelle PulseCanvas prosjekter kan åpnes på andre plattformer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstel deze volledige back-up op %@. Individual PulseCanvas projecten kunnen worden geopend op andere platforms."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura esta backup completa em %@. projetos individuais PulseCanvas podem ser abertos em outras plataformas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återställ denna fullständig säkerhetskopia på %@. Individual PulseCanvas projekt kan öppnas på andra plattformar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tam yedeklemeyi %@'de kurun. bireysel PulseCanvas projeleri diğer platformlarda açılabilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khôi phục sao lưu đầy đủ này trên %@. Các dự án riêng biệt PulseCanvas có thể được mở trên các nền tảng khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复此完整的备份在 %@. 个人 PulseCanvas 项目可以在其他平台上打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復此完整的備份在 %@. 個人 PulseCanvas 專案可以在其他平臺上開啟。"
          }
        }
      }
    },
