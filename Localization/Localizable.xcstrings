    "Music and visuals on shuffle. Choose all, favorites, or a station.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Musik og visualer på shuffle. Vælg alle, favoritter eller en station."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Musik und Visualisierungen auf Shuffle. Wählen Sie alle, Favoriten oder eine Station aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Música y visualizaciones en la guía. escoge todos, favoritos o una estación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Musique et visuels sur le shuffle. Choisissez tous, les favoris ou une station."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Musica e visuali su shuffle. Scegli tutti, preferiti o una stazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音楽とビデオをシャフルで選択してください、すべての好きなもの、またはステーションを選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음악 및 시각을 샤프플에. 모두, 좋아하는 사람, 또는 역을 선택합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Musikk og visualer på shuffle. Velg alle, favoritter eller en stasjon."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Muziek en visuele op de shuffle.Kies alle, favorieten of een station."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Música e visualizações no shuffle. Escolha todos, favoritos ou uma estação."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Musik och visuella på shuffle. Välj alla, favorit eller en station."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şifreleme ve müzikler. tüm, favori veya bir istasyon seçin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm nhạc và hình ảnh trên shuffle. chọn tất cả, yêu thích, hoặc một trạm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音乐和视觉在 shuffle. 选择所有,最喜欢的,或站。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音樂和視覺在 shuffle. 選擇所有,最喜歡的,或站。"
          }
        }
      }
    },
