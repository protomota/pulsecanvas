          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Muziek in bewegende visuals. Gratis te gebruiken, zonder account of abonnement."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Música para visualizações móveis. Grátis de usar, sem conta ou assinatura."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
