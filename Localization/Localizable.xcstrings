    "How strongly shapes react to music. Zero keeps procedural motion.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor stærkt former reagerer på musik. Zero holder procedurel bevægelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie stark reagiert die Form auf Musik.Zero hält die Verfahrenbewegung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuán fuerte reacciona la forma a la música?Zero mantiene el movimiento procedural."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien de fortes formes réagissent à la musique.Zero maintient le mouvement procédural."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto forte reagisce la forma alla musica. zero mantiene il movimento procedurale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音楽にどれだけ強い形態が反応するか?ゼロはプロセス動きを維持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음악에 얼마나 강하게 반응하는지.Zero는 절차적 움직임을 유지합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor sterk form reagerer på musikk. Zero holder prosedural bevegelse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe sterk vormt hij zich op muziek reageert.Zero houdt de procedurele beweging vast."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como fortes formas reagem à música. zero mantém o movimento procedural."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur starkt former reagerar på musik. Zero håller procedurell rörelse."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Müzik için ne kadar güçlü bir şekilde tepki gösterir.Zero prosedürel hareketleri korur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm thế nào mạnh mẽ hình dạng phản ứng với âm nhạc. Zero giữ cho phong trào thủ tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如何强烈地对音乐作出反应?零保持程序动作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如何強烈地對音樂作出反應?零保持程式動作。"
          }
        }
      }
    },
