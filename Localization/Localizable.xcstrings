    "Radio downloads music to this Mac for playback and analysis. Your own soundtracks stay on your Mac.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Radio downloader musik til denne Mac for playback og analyse. dine egne soundtrackes forbliver på din Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Radio herunterladen Musik auf diesen Mac für Wiedergabe und Analyse. Ihre eigenen Soundtrack bleiben auf Ihrem Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Radio descarga música a este Mac para reproducir y analizar. sus propias sonoras permanecen en su Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Radio télécharge la musique à ce Mac pour le replay et l'analyse. Vos propres traces sonores restent sur votre Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Radio scarica musica a questo Mac per riproduzione e analisi. i tuoi propri soundtrack rimangono sul tuo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ラジオは、再生と分析のためにこのMacに音楽をダウンロードします. あなたの独自の音声トラックが Mac に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라디오는 재생 및 분석을 위해이 Mac에 음악을 다운로드합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Radio nedlaster musikk til denne Mac for spillback og analyse. dine egne lydspor blir på din Mac."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Radio downloads muziek naar deze Mac voor afspelen en analyse. uw eigen soundtrack blijven op uw Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A rádio descarrega música para este Mac para reprodução e análise. seus próprios saídas sonoras permanecem no seu Mac."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Radio ladda ner musik till denna Mac för spellång och analys. Dina egna ljudtrackar stannar på din Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Radyo, oynatma ve analiz için bu Mac'e müzik indirir. kendi ses izleri Mac'inizde kalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Radio tải nhạc đến Mac này để xem lại và phân tích. âm thanh của bạn vẫn còn trên Mac của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "广播电台下载音乐到这个Mac的播放和分析. 您的自己的音频轨道留在你的Mac。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "廣播電臺下載音樂到這個Mac的播放和分析. 您的自己的音訊軌道留在你的Mac。"
          }
        }
      }
    },
