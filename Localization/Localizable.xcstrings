        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tia sáng trắng theo dõi các cuộc tấn công tần số cao nhanh trong âm thanh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
