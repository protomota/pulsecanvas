    "Swipe left or right to change the visualizer while keeping the current song. Double-tap to favorite the visualizer.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skift til venstre eller højre for at ændre visualiseren mens du holder den aktuelle sang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalten Sie links oder rechts, um den Visualiser zu ändern und während der aktuellen Song behalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar a la izquierda o derecha para cambiar el visualizador mientras se mantiene la canción actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez à gauche ou à droite pour changer le visualisateur tout en gardant la chanson actuelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spostare a sinistra o destra per cambiare il visualizzatore mentre mantiene la canzone corrente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左または右をスイッチして、現在の曲を保持しながら視聴器を変更します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 노래를 유지하는 동안 왼쪽 또는 오른쪽으로 스위치하여 시각기를 변경합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skift til venstre eller høyre for å endre visualiseren mens du holder den aktuelle sangen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuur links of rechts om de visualisator te veranderen terwijl het huidige lied wordt bewaard."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mude à esquerda ou à direita para alterar o visualizador enquanto mantém a música corrente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe vänster eller höger för att ändra visualiseringen medan den aktuella låten håller. dubbeltryck till favorit visualiseringen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şarkıyı tutarken görsellerin değiştirilmesi için sol veya sağ çarpın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển sang trái hoặc phải để thay đổi trình chiếu trong khi giữ cho bài hát hiện tại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向左或右转换,以更改视图器同时保持当前歌曲。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向左或右轉換,以更改檢視器同時保持當前歌曲。"
          }
        }
      }
    },
