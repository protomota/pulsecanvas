    "Save a portable backup to restore in another build or on another Mac.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spare en bærbar sikkerhedskopiering til at gendanne i et andet opbygning eller på en anden Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern Sie eine portable Backup, um in einem anderen Build oder auf einem anderen Mac wiederherzustellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva una copia de seguridad portátil para restaurar en otro edificio o en otro Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauver une sauvegarde portable pour récupérer dans un autre bâtiment ou sur un autre Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva una backup portatile per ripristinare in un altro build o su un altro Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の構築または他のMacで復元するために携帯バックアップを保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 버전 또는 Mac에서 복구하기 위해 휴대용 백업을 저장합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spare en bærbar sikkerhetskopiering for å gjenopprette i et annet sett eller på en annen Mac."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Speel een draagbare back-up om te herstellen in een andere build of op een andere Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve uma backup portátil para restaurar em outro edifício ou no outro Mac."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spara en bärbar säkerhetskopia för att återställa i ett annat byggnad eller på en annan Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir başka yapıya veya başka bir Mac'te kurtarmak için taşınabilir bir yedekleme kaydetmek."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu một bản sao lưu di động để phục hồi trong một cấu trúc hoặc trên Mac khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存一个移动备份,以便在另一个构建或其他Mac中恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存一個移動備份,以便在另一個構建或其他Mac中恢復。"
          }
        }
      }
    },
    "Save a project to add it to iCloud. Projects download when you open them.": {
      "localizations": {
