    "Your Apple Account changed. Confirm iCloud sync again before merging local data with this account.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekræft iCloud synkronisering igen, før du kombinerer lokale data med denne konto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätigen Sie iCloud synchronisieren wieder, bevor Sie lokale Daten mit diesem Konto kombinieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmar la sincronización de iCloud nuevamente antes de combinar datos locales con esta cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Compte Apple a changé.Confirmez iCloud synchroniser à nouveau avant de combiner les données locales avec ce compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmare iCloud sincronizzare di nuovo prima di combinare i dati locali con questo account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの Apple アカウントが変更されました. このアカウントと地元のデータを組み合わせる前に iCloud 再び同期することを確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 계정이 변경되었습니다.이 계정과 로컬 데이터를 결합하기 전에 iCloud 다시 동기화 확인합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekreft iCloud synkronisering igjen før du kombinerer lokale data med denne kontoen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm iCloud synchroniseren opnieuw voordat u lokale gegevens met dit account combineert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme a sincronização de iCloud novamente antes de combinar dados locais com esta conta."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekräfta iCloud synkronisera igen innan du kombinerar lokala data med detta konto."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Hesabınız Değiştirildi. bu hesapla yerel verileri birleştirmeden önce iCloud'yi yeniden senkronize etmeyi onaylayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản Apple của bạn đã thay đổi. xác nhận iCloud đồng bộ lại trước khi kết hợp dữ liệu địa phương với tài khoản này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 Apple 帐户已改变. 在将本地数据与此帐户合并之前,请重新确认 iCloud 同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 Apple 帳戶已改變. 在將本地資料與此帳戶合併之前,請重新確認 iCloud 同步。"
          }
        }
      }
    },
    "Your Apple Account changed. Local data was kept. Confirm iCloud sync again to use the current account.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Apple-konto ændret. Lokale data blev gemt. Bekræft iCloud synkronisering igen for at bruge det nuværende konto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Apple-Konto wurde geändert.Lokale Daten wurden gespeichert.Konfirmen Sie iCloud wieder synchronisiert, um das aktuelle Konto zu verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su cuenta de Apple cambió. los datos locales se conservaron. confirmar iCloud sincronizar nuevamente para utilizar la cuenta actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Compte Apple a changé. Les données locales ont été conservées. Confirmez iCloud synchroniser à nouveau pour utiliser le compte actuel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo account Apple è cambiato. i dati locali sono stati conservati. conferma iCloud sincronizzare di nuovo per utilizzare il conto corrente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple アカウントが変更されました. 地元のデータが保存されました. iCloud 再び同期を確認して現在のアカウントを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 계정이 변경되었습니다.지방 데이터가 저장되었습니다.iCloud 다시 동기화하여 현재 계정을 사용하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Apple-konto endret. lokale data ble lagret. bekreft iCloud synkronisere igjen for å bruke den nåværende kontoen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw Apple-account is veranderd.Locale gegevens zijn bewaard.Confirm iCloud sync opnieuw om het huidige account te gebruiken."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua Conta Apple mudou. dados locais foram mantidos. confirmar iCloud sincronizar novamente para usar a conta atual."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Apple-konto ändrades. Lokala data lagras. Bekräfta iCloud synkronisera igen för att använda det aktuella kontot."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Hesabınız değişti. yerel veriler saklandı. iCloud'yi tekrar senkronize etmeyi doğrulayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản Apple của bạn đã thay đổi.Dữ liệu địa phương được lưu trữ.Xem lại đồng bộ với iCloud để sử dụng tài khoản hiện tại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 Apple 帐户已更改. 地点数据已保存. 再次验证 iCloud 同步以使用当前帐户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 Apple 帳戶已更改. 地點資料已儲存. 再次驗證 iCloud 同步以使用當前帳戶。"
          }
        }
      }
    },
    "Your current Studio project and app-managed files are included. Add older projects saved elsewhere to include them and their soundtracks. Downloaded public Radio caches, exported videos, sign-in data and purchase records are excluded.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine nuværende Studio-projekter og app-managed filer er inkluderet. tilføje ældre projekter gemt andre steder for at inkludere dem og deres lydspor. Downloadede offentlige Radio caches, eksporteret videoer, login data og købsregistre er udelukket."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre aktuellen Studio-Projekte und App-verwaltungsdateien sind enthalten. fügen Sie ältere Projekte an anderer Stelle gespeichert, um sie und ihre Soundtrack zu enthalten. Download öffentliche Radio-Caches, exportierten Videos, Anmeldedaten und Kaufregister sind ausgeschlossen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su actual proyecto de Studio y los archivos gestionados por la aplicación están incluidos.Añadir proyectos mayores guardados en otro lugar para incluirlos y sus rastros sonoros.Se excluyen cache público de radio, videos exportados, datos de registro y registros de compra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos projets actuels Studio et les fichiers gérés par l'application sont inclus. Ajouter des projets plus anciens sauvés ailleurs pour les inclure et leurs traces sonores. Les cache radio publiques téléchargées, les vidéos exportées, les données d'inscription et les enregistrements d'achat sont exclues."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file attuali del tuo progetto Studio e gestiti dall'app sono inclusi. Aggiungi progetti vecchi salvati altrove per includere loro e le loro tracce audio. Sono esclusi i cache pubblici di Radio scaricati, i video esportati, i dati di iscrizione e gli record di acquisto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のスタジオプロジェクトやアプリ管理ファイルが含まれています. 他の場所で保存されている古いプロジェクトを追加して、それらとその音声トラックを含みます. 公開ラジオキャッシュ、輸出されたビデオ、サインインデータ、および購入記録をダウンロードする。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재의 스튜디오 프로젝트 및 앱 관리 파일이 포함되어 있습니다. 다른 곳에서 저장된 오래된 프로젝트를 추가하여 그들과 그들의 사운드 트랙을 포함합니다. 다운로드 된 공공 라디오 캐시, 수출 된 비디오, 로그인 데이터 및 구매 기록은 제외됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine nåværende Studio-prosjekter og app-administraserte filer er inkludert. Legg til eldre prosjekter som er lagret andre steder for å inkludere dem og deres lydspor. Nedlastede offentlige Radio-kasjer, eksporterte videoer, innloggingsdata og kjøpsregistreringer er utelukket."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw huidige Studio-project en app beheerde bestanden zijn opgenomen. Voeg oudere projecten op een andere plaats opgeslagen om ze en hun soundtrack te bevatten. Downloadte publieke Radio cache's, geëxporteerde video's, inloggegevens en aankooprecords zijn uitgesloten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu projeto atual Studio e arquivos gerenciados por aplicativos estão incluídos. Adicione projetos mais antigos salvos em outros lugares para incluí-los e suas faixas sonoras. Caches de rádio públicos baixados, vídeos exportados, dados de inscrição e registros de compras são excluídos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina nuvarande Studio-projekt och apphanterade filer ingår. Lägg till äldre projekt som sparas någon annanstans för att inkludera dem och deras ljudtrack. Ladda ner offentliga Radio cachor, exporterade videor, inloggningsdata och köpregistret är uteslutna."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut Studio projesi ve uygulama yönetilen dosyalar dahil edilir. onları ve ses izlerini içermek için başka bir yerde kaydedilen eski projeleri ekleyin. indirilmiş kamu Radyo cache, ihraç edilen videolar, giriş verileri ve satın alma kayıtları hariç tutulur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các dự án Studio hiện tại và các tệp được quản lý bởi ứng dụng của bạn được bao gồm. thêm các dự án cũ đã lưu ở nơi khác để bao gồm chúng và âm thanh của họ. cache phát thanh công cộng, video xuất khẩu, dữ liệu đăng nhập và hồ sơ mua hàng bị loại trừ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的当前 Studio 项目和应用程序管理的文件都包含. 添加其他地方保存的旧项目,以便包括它们和其音频轨道. 下载的公共广播电台,出口的视频,登录数据和购买记录被排除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的當前 Studio 專案和應用程式管理的檔案都包含. 新增其他地方儲存的舊專案,以便包括它們和其音訊軌道. 下載的公共廣播電臺,出口的影片,登入資料和購買記錄被排除。"
          }
        }
      }
    },
    "Your current visualizer choices will be replaced.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine nuværende visualiseringsvalg vil blive erstattet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre aktuellen Visualisierungsoptionen werden ersetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus opciones de visualización actuales serán reemplazadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos options actuelles de visualisateur seront remplacées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le opzioni di visualizzatore attuali saranno sostituite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の視聴者選択肢が置き換えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
