    "Visualizer order, soundtrack and saved styles stay unchanged.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualiser ordre, soundtrack og gemte stilarter forbliver uændret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualisierung der Bestellung, Soundtrack und gespeicherten Styles bleiben unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El orden de visualización, el soundtrack y los estilos salvos permanecen inalterados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ordre visualisateur, le soundtrack et les styles sauvés restent inchangés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualizza l'ordine, il soundtrack e gli stili salvati rimangono invariati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーダー、サウンドトラック、保存されたスタイルを表示するには、変更されないままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명령, 사운드 트랙 및 저장된 스타일을 시각화하는 것은 변함없이 유지됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualiserordre, soundtrack og lagrede stiler forblir uendret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De visualisatie van de orde, soundtrack en gereserveerde stijlen blijven onveranderd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A ordem de visualização, o soundtrack e os estilos salvos permanecem inalterados."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualisera order, soundtrack och spara stilar förblir oförändrade."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görüntüleme siparişi, sesli çizgi ve kaydedilen stiller değişmez kalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lệnh hiển thị, âm thanh và các phong cách được tiết kiệm vẫn không thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视觉命令、音频和保存的风格保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視覺命令、音訊和儲存的風格保持不變。"
          }
        }
      }
    },
    "Visualizer order, soundtrack, and saved settings stay.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualiser ordre, soundtrack og gemte indstillinger forblive."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualisieren Sie die Bestellung, Soundtrack und gespeicherte Einstellungen bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualizar el orden, la pista de sonido y los ajustes salvos permanecen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualiser l'ordre, le soundtrack et les paramètres sauvés demeurer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualizza ordine, soundtrack e la permanenza delle impostazioni salvate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーダー、サウンドトラック、保存設定の滞在を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "순서, 사운드 트랙 및 저장 설정이 남아있는 것을 시각화합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualiser ordre, soundtrack og lagrede innstillinger for å holde."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualiseren bevel, soundtrack en gereserveerde instellingen verblijven."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualize a ordem, o soundtrack e as configurações salvas permanecem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualisera order, soundtrack och spara inställningar för att stanna."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sipariş, sesli iz ve kaydedilen ayarları görüntüleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem lệnh, soundtrack và lưu trữ cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看命令、音频轨道和保存设置留下。"
