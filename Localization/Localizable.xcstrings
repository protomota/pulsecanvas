    "Some OpenGL presets may become darker or look different. Choose 60 fps if this happens.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nogle OpenGL-præset kan blive mørkere eller se anderledes ud. Vælg 60 fps, hvis dette sker."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige OpenGL Vorseiten können dunkler oder anders aussehen. Wählen Sie 60 fps, wenn dies passiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos presetos de OpenGL pueden ser más oscuros o ver diferentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains prédécesseurs de OpenGL peuvent devenir plus sombres ou paraître différents. Choisissez 60 fps si cela se produit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni pre-set OpenGL possono diventare più scuri o sembrare diversi. Scegli 60 fps se questo accade."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いくつかの OpenGL プレセットは暗くなったり、異なるように見えるかもしれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 OpenGL 프레세트가 어두워지거나 다른 모습을 보일 수 있습니다.이 경우 60 fps를 선택합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noen OpenGL-preset kan bli mørkere eller se annerledes ut. Velg 60 fps hvis dette skjer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige OpenGL-voorstellingen kunnen donkerder of anders uitzien. 60 fps kiezen als dit gebeurt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns preceitos OpenGL podem ficar escuros ou parecer diferentes. Escolha 60 fps se isso acontecer."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vissa OpenGL-preset kan bli mörkare eller se annorlunda. välj 60 fps om detta händer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı OpenGL ön aygıtları daha karanlık veya farklı görünebilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một số bộ trước OpenGL có thể trở nên tối hơn hoặc trông khác nhau. chọn 60 fps nếu điều này xảy ra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有些 OpenGL 前置可能变得更黑暗或看起来不同. 如果发生,请选择 60 fps。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有些 OpenGL 前置可能變得更黑暗或看起來不同. 如果發生,請選擇 60 fps。"
          }
        }
      }
    },
