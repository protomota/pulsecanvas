    "Play the Studio timeline full screen from the current position. Escape returns to the editor.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spil den Studio timeline fuldskærm fra den aktuelle position. Escape returnerer til redaktøren."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielen Sie den Studio Timeline volles Bildschirm aus der aktuellen Position. Escape kehrt an die Editor zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Juega la pantalla completa de la línea horaria del Studio desde la posición actual. Escape vuelve al editor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouez à l'écran complet de la ligne horaire Studio de la position actuelle. Escape revient au éditeur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gioca la schermata completa della linea di tempo Studio dalla posizione corrente. Escape ritorna all'editore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スタジオタイムラインの現在の位置からフルスクリーンをプレイします. Escape は編集者に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 위치에서 스튜디오 타임 라인 전체 화면을 재생합니다. 탈출은 편집자에게 돌아갑니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spill Studio timeline fullskjerm fra den nåværende posisjonen. Escape returnerer til redaktøren."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Speel de Studio timeline volledige scherm van de huidige positie. Escape keert terug naar de editor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogue a tela completa da linha de tempo do Studio da posição atual. Escape retorna ao editor."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spela hela skärmen i Studio timeline från den aktuella positionen. Escape returnerar till redaktören."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio zaman çizgisini mevcut konumdan tam ekran oynayın. Escape editörüne geri döner."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chơi màn hình đầy đủ của dòng thời gian Studio từ vị trí hiện tại. Escape trở lại với biên tập viên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从当前位置播放 Studio 时间线全屏, Escape 返回编辑器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從當前位置播放 Studio 時間線全屏, Escape 返回編輯器。"
          }
        }
      }
    },
