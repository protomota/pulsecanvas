    "Open the immersive screen to surround yourself with the visuals, or export your Studio project as an MP4.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn den immersive skærm for at omringes med visuelle billeder eller eksportere dit Studio projekt som en MP4."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie den immersiven Bildschirm, um sich mit den Visualen zu umgeben oder Ihr Studio-Projekt als MP4 auszuüben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la pantalla inmersiva para rodearse con las imágenes, o exportar su proyecto de estudio como un MP4."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez l’écran immersif pour vous entourer des visuels, ou exportez votre projet Studio en tant que MP4."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri lo schermo immersivo per circondarti con le visuali, o esportare il tuo progetto Studio come MP4."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インプラントスクリーンを開いて、視覚で自分自身を包み込むか、スタジオプロジェクトをMP4としてエクスポートします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "침투 화면을 열어 시각으로 자신을 둘러싸거나 스튜디오 프로젝트를 MP4로 내보내십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne den immersive skjermen for å omringes med visuell, eller eksportere Studio-prosjektet som en MP4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open het immersieve scherm om jezelf te omringen met de visuals, of exporteer uw Studio project als een MP4."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra a tela immersiva para se envolver com as imagens ou exportar o seu projeto de estúdio como um MP4."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna den immersiva skärmen för att omge dig med visuella bilder, eller exportera ditt Studio-projekt som en MP4."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görüntülerle çevriliğiniz için dalış ekranını açın veya Studio projenizi bir MP4 olarak ihraç edin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở màn hình đầy thói quen để bao quanh mình với các hình ảnh, hoặc xuất dự án Studio của bạn như một MP4."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开沉浸式屏幕,以便将自己包围视觉或将您的 Studio 项目作为 MP4 导出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟沉浸式螢幕,以便將自己包圍視覺或將您的 Studio 專案作為 MP4 匯出。"
          }
        }
      }
    },
