          "stringUnit": {
            "state": "translated",
            "value": "Ads flashes rápidos en el tiempo con la percusión de alta frecuencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ajoute des flammes rapides dans le temps avec une percussion à haute fréquence."
          }
        },
        "it": {
