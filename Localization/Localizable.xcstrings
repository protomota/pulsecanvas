    "No matches in your visualizer pool. Change the pool or turn its limit off.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen match i din visualiseringspool. ændre pool eller slå grænsen ud."
          }
        },
        "de": {
