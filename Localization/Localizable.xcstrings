    "Locate this project’s soundtrack: %@. Saved projects reference audio files; they do not include the audio.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Find dette projekts lydspor: %@. Saved projekter reference audio filer; de indeholder ikke lyd."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finden Sie die Soundtrack dieses Projekts: %@. Erhaltete Projekte Referenz-Audio-Dateien; sie enthalten nicht das Audio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Localizar la pista sonora de este proyecto: %@. Los proyectos salvados se refieren a los archivos de audio; no incluyen el audio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Localisez la sonde de ce projet: %@. Les fichiers audio de référence des projets sauvés; ils ne comprennent pas l'audio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Localizzare la traccia audio di questo progetto: %@. Progetti salvati file audio di riferimento; non includono l'audio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロジェクトの音声トラックを検索する: %@. 保存されたプロジェクトは、参考オーディオファイル; 彼らはオーディオを含まない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프로젝트의 사운드 트랙을 찾으십시오: %@. 저장된 프로젝트 참조 오디오 파일; 그들은 오디오를 포함하지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Finn dette prosjektets lydspor: %@. Saved prosjekter referanse audio filer; de inkluderer ikke lyd."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Locatie van de soundtrack van dit project: %@. bewaard projecten referentiedaten audio bestanden; ze niet de audio."
          }
        },
        "pt-BR": {
