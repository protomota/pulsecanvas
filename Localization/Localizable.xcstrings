            "state": "translated",
            "value": "Denne radio katalogen er gyldig.Vilg en versjon 1 katalog med HTTPS audio URLs."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze radio catalogus is niet geldig.Kies een versie 1 catalogus met HTTPS audio URL's."
          }
