    "White flashes follow rapid high-frequency attacks in the soundtrack.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvide flasher følger hurtige højfrekvensangreb i soundtrack."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weiße Blätter folgen schnellen Hochfrequenz-Angriffen im Soundtrack."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las flashes blancas siguen rápidos ataques de alta frecuencia en el soundtrack."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les flammes blanches suivent des attaques à haute fréquence rapides dans le soundtrack."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I flash bianchi seguono attacchi ad alta frequenza rapidi nel soundtrack."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホワイトフラッシュは、音声トラックで迅速な高周波数攻撃を追跡します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화이트 플래시는 소음 트랙에서 빠른 고주파 공격을 추적합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvite blader følger raske høyfrekvensangrep i lydtracken."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Witte flits volgen snelle high-frequency aanvallen in de soundtrack."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os flashes brancos seguem ataques rápidos de alta frequência no soundtrack."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vita fläckar följer snabba högfrekventa attacker i soundtrack."
