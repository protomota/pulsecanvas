    "No changes were made. Choose a larger visualizer group or fewer sections, then try again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg en større visualiseregruppe eller færre sektioner, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie eine größere Visualisierungsgruppe oder weniger Abschnitte aus, dann versuchen Sie erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se hicieron cambios. escoge un grupo de visualizadores más grande o menos secciones, luego intenta nuevamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un groupe de visualisateurs plus grand ou moins de sections, puis essayez à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un gruppo di visualizzatori più grande o meno sezioni, quindi prova di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更はありません. より大きな視聴者グループまたはより少ないセクションを選択し、再度試してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 큰 시각 그룹 또는 덜 섹션을 선택한 다음 다시 시도합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg en større visualiseregruppe eller færre seksjoner, og prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een grotere visualisergroep of minder secties, probeer dan weer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não houve alterações. escolha um grupo de visualizadores maior ou secções menores, então tente novamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj en större visualiseringsgrupp eller färre sektioner, försök sedan igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha büyük bir görüntüleyici grubu veya daha az bölüm seçin, sonra tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một nhóm trình xem lớn hơn hoặc các phần nhỏ hơn, sau đó thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有更改,选择一个更大的视图组或较少的部分,然后再试一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有更改,選擇一個更大的檢視組或較少的部分,然後再試一次。"
          }
        }
      }
    },
