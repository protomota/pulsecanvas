    "Every feature is free, with no account or subscription. Your support helps us keep building.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle funktioner er gratis, uden konto eller abonnement. Din support hjælper os med at holde opbygningen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Funktion ist kostenlos, ohne Konto oder Abonnement. Ihre Unterstützung hilft uns, weiterhin zu bauen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada función es gratuita, sin cuenta ni suscripción. tu soporte nos ayuda a mantener la construcción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque fonctionnalité est gratuite, sans compte ni abonnement.Votre support nous aide à continuer à construire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni funzionalità è gratuita, senza account o abbonamento. il tuo supporto ci aiuta a mantenere la costruzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての機能は無料で、アカウントやサブスクリプションはありません. あなたのサポートは私たちが構築を維持するのに役立ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 기능은 무료이며, 계정이나 구독이 없습니다.당신의 지원은 건설을 계속하는 데 도움이됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle funksjoner er gratis, uten konto eller abonnement. Din støtte hjelper oss å holde bygging."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke functie is gratis, zonder account of abonnement. uw ondersteuning helpt ons om te blijven bouwen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada recurso é gratuito, sem conta ou assinatura. seu suporte nos ajuda a manter o edifício."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla funktioner är gratis, utan konto eller prenumeration.Din support hjälper oss att hålla byggandet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her özellik ücretsizdir, hiçbir hesap veya abonelik yoktur. destekleriniz inşaatımızı sürdürmemize yardımcı olur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi tính năng là miễn phí, không có tài khoản hoặc đăng ký. hỗ trợ của bạn giúp chúng tôi tiếp tục xây dựng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每個功能都是免費的,沒有帳戶或訂閱.您的支持幫助我們保持建築。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個功能都是免費的,沒有帳戶或訂閱.您的支援幫助我們保持建築。"
          }
        }
      }
    },
