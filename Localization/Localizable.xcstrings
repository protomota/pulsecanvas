    "Number of rings in each travelling group. Add more for a denser field of halos.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Antallet af ringer i hver rejsegruppe. tilføje mere for et tættere halosfelt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anzahl der Ringe in jeder Reisegruppe. fügen Sie mehr für ein dichteres Halosfeld hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Número de anillos en cada grupo de viaje.Añadir más para un campo más denso de halos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre d'anneaux dans chaque groupe de voyage. Ajouter plus pour un champ plus dense des halos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Numero di anelli in ogni gruppo di viaggio. Aggiungi più per un campo di halosi più densi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各旅行グループに指輪数を追加し、より密度の高いハロスフィールドを追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 여행 그룹에 반지 수. 더 밀접한 홀로 필드를 위해 더 많은 것을 추가합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Antall ringer i hver reisegruppe. Legg til mer for et tettere halosfelt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aantal ringen in elke reisgroep. Voeg meer toe voor een dichtere halosveld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Número de anéis em cada grupo de viagem. Adicione mais para um campo mais denso de halos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Antal ringar i varje resegrupp. Lägg till mer för ett djupare halosfält."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her seyahat grubunda yüzük sayısı. daha yoğun bir halos alanı için daha fazlasını ekleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số vòng trong mỗi nhóm du lịch.Hãy thêm nhiều hơn cho một lĩnh vực halo dày hơn."
          }
        },
        "zh-Hans": {
