    "Roll shared style settings and replay this section; all sections using this visualizer update": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Roll delte stilindstillinger og genoptage denne sektion; alle sektioner ved hjælp af denne visualiserings opdatering"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Roll die gemeinsamen Stil-Einstellungen und wiederherstellen Sie diese Abschnitt; alle Abschnitte mit dieser Visualisierungsupdate"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Roll las configuraciones de estilo compartido y reproducir esta sección; todas las secciones utilizando esta actualización del visualizador"
          }
        },
        "fr": {
          "stringUnit": {
