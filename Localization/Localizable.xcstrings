    "This timeline has %lld sections and %lld available visualizers. Use longer sections or add visualizers to randomize without repeats.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne tidsramme har %lld sektioner og %lld tilgængelige visualisere. Brug længere sektioner eller tilføje visualisere til at randomisere uden gentagelser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Zeitraum hat %lld Abschnitte und %lld verfügbare Visualisatoren. Verwenden Sie längere Abschnitte oder fügen Sie Visualisatoren hinzu, um ohne Wiederholungen zu randomisieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta línea de tiempo tiene secciones %lld y visualizadores disponibles %lld. Utilice secciones más largas o añade visualizadores para randomizar sin repeticiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette ligne de temps a des sections %lld et des visualisateurs disponibles %lld. Utilisez des sections plus longues ou ajoutez des visualisateurs pour les randomiser sans répétition."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa linea di tempo ha sezioni %lld e visualizzatori disponibili %lld. Utilizzare sezioni più lunghe o aggiungere visualizzatori per randomizzare senza ripetizioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタイムラインには %lld セクションと %lld 利用可能な視聴器があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 시간표에는 %lld 섹션과 %lld 시각가가 있습니다.더 긴 섹션을 사용하거나 시각가를 추가하여 반복없이 우연히 시각화합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne timelinjen har %lld-sektioner og %lld-visualisere tilgjengelig. Bruk lengre sektioner eller legg til visualisere for å tilfeldiggjøre uten gjentakelser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze tijdlijn heeft %lld secties en %lld beschikbare visualisers. gebruik langer secties of voeg visualisers toe om zonder herhalingen te randomiseren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta linha de tempo tem seções %lld e visualizações disponíveis %lld. Use seções mais longas ou adicione visualizações para randomizar sem repetições."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Denna tidslinje har %lld sektioner och %lld tillgängliga visualiserare. Använd längre sektioner eller lägg till visualiserare för att randomisera utan upprepningar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu zaman çizgisinde %lld bölümleri ve %lld mevcut görüntüleme cihazları vardır. daha uzun bölümler kullanın veya tekrarlamadan rastgele görüntüleme cihazlarını ekleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dòng thời gian này có các phần %lld và các trình duyệt %lld sẵn dùng. Sử dụng các phần dài hơn hoặc thêm trình duyệt để ngẫu nhiên hóa mà không cần lặp lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此时间线有 %lld 分区和 %lld 可用的视觉器. 使用更长的分区或添加视觉器随机化,而无需重复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此時間線有 %lld 分割槽和 %lld 可用的視覺器. 使用更長的分割槽或新增視覺器隨機化,而無需重複。"
          }
        }
      }
    },
