    "iCloud sync history couldn't be read. Sync is off; local data and the original history were kept.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Sync er ud; lokale data og den oprindelige historie blev bevaret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Synchronisierungsgeschichte konnte nicht gelesen werden. Synchronisierung ist ausgeschlossen; lokale Daten und die ursprüngliche Geschichte wurden beibehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinceros de iCloud historia no se podía leer. sinceros está desactivado; los datos locales y la historia original fueron conservados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Sync est désactivé; les données locales et l'histoire originale ont été conservées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud storia di sincronizzazione non poteva essere letto. la sincronizzazione è aperta; i dati locali e l'originale storia sono stati conservati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 同期の歴史は読み取れませんでした. 同期が終了しました; 地元データとオリジナルの歴史が保存されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 동기화 역사 읽을 수 없었다. 동기화가 꺼져; 지역 데이터와 원래 역사가 보존되었다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Synk er av; lokale data og den opprinnelige historien ble bevaret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud synchronisatiegeschiedenis kon niet worden gelezen. synchronisatie is uitgesloten; lokale gegevens en de oorspronkelijke geschiedenis werden bewaard."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A história de sincronização iCloud não foi lida. a sincronização está desligada; os dados locais e a história original foram mantidos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud synkroniseringshistoria kunde inte läsas. Synkroniseringen är av; lokala data och originalhistoria bevarades."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud senkronizasyon geçmişi okunamaz. senkronizasyon kapatılır; yerel veriler ve orijinal geçmişi saklanır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Lịch sử đồng bộ không thể đọc được.Sync đã tắt; dữ liệu địa phương và lịch sử ban đầu đã được giữ lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 同步历史无法阅读. 同步已关闭;本地数据和原始历史被保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 同步歷史無法閱讀. 同步已關閉;本地資料和原始歷史被儲存。"
          }
        }
      }
    },
    "iCloud sync is off. Local files and existing iCloud copies are kept.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud synkroniseres. lokale filer og eksisterende iCloud kopier bevares."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Synchronisierung ist abgeschaltet. Lokale Dateien und bestehende Kopien von iCloud werden gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud El archivo local y los existentes iCloud Las copias se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisation iCloud est désactivée. les fichiers locaux et les copies existantes de iCloud sont conservés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il sincronizzazione di iCloud è aperto. i file locali e le copie esistenti di iCloud sono conservati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 同期が終了します. 現地ファイルおよび既存の iCloud コピーは保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 동기화가 꺼져 있습니다. 로컬 파일과 기존 iCloud 복사본이 보관됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Synkronisering er av. Lokale filer og eksisterende iCloud Kopier er holdt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud synchronisatie is uitgeschakeld. lokale bestanden en bestaande kopieën van iCloud worden bewaard."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O sincronismo iCloud está apagado. arquivos locais e cópias existentes iCloud são mantidos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud synkronisering är av. Lokala filer och befintliga kopior av iCloud sparas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud senkronizasyonu kapatılır. yerel dosyalar ve mevcut iCloud kopyaları saklanır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xử lý iCloud được mở. các tập tin địa phương và bản sao iCloud hiện có được lưu trữ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 同步已关闭. 保留本地文件和现有 iCloud 副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 同步已關閉. 保留本地檔案和現有 iCloud 副本。"
          }
        }
      }
    },
    "iCloud sync is off. Your data stays on this device.": {
