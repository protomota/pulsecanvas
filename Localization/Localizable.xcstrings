    "Keep visualizer favorites, song favorites, saved looks and saved projects available on your Mac, iPhone, iPad and Apple Vision Pro using the same Apple Account.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold visualiser favoritmer, sang favoritter, gemte udseende og gemte projekter til rådighed på din Mac, iPhone, iPad og Apple Vision Pro ved hjælp af samme Apple-konto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie die Visualisierungs-Favoritäten, Song-Favoritäten, gespeicherte Aussichten und gespeicherte Projekte auf Ihrem Mac, iPhone, iPad und Apple Vision Pro mit demselben Apple Account verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga los favoritos de visualizador, los favoritos de canciones, las apariencias salvas y los proyectos salvos disponibles en su Mac, iPhone, iPad y Apple Vision Pro utilizando la misma cuenta Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez les préférés de visualisation, les préférés de chansons, les vues sauvées et les projets sauvés disponibles sur votre Mac, iPhone, iPad et Apple Vision Pro en utilisant le même compte Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenere visualizzatori preferiti, preferiti di canzoni, guardate e progetti salvati disponibili sul Mac, iPhone, iPad e Apple Vision Pro utilizzando lo stesso account Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのMac、iPhone、iPad、Apple Vision Proで同じ Apple アカウントを使用して視聴者ファミリー、曲のファミリー、保存された外観、および保存されたプロジェクトを保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동일한 Apple 계정을 사용하여 Mac, iPhone, iPad 및 Apple Vision Pro에서 시각화 좋아하는 것, 노래 좋아하는 것, 저장된 모양 및 저장된 프로젝트를 사용할 수 있도록 유지합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold visualiser favoritter, sang favoritter, sparte utseende og sparte prosjekter tilgjengelige på Mac, iPhone, iPad og Apple Vision Pro ved hjelp av samme Apple-konto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd de visualiser-favorites, liedjesfavorites, gered look en gered projects beschikbaar op uw Mac, iPhone, iPad en Apple Vision Pro met dezelfde Apple Account."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha os favoritos de visualização, favoritos de música, aparelhos salvos e projetos salvos disponíveis no seu Mac, iPhone, iPad e Apple Vision Pro usando a mesma Conta da Apple."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll visualiserare favorit, låt favorit, spara utseende och spara projekt tillgängliga på din Mac, iPhone, iPad och Apple Vision Pro med samma Apple-konto."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görüntüleme favorileri, şarkı favorileri, kaydedilen görünümler ve kaydedilen projeleri Mac, iPhone, iPad ve Apple Vision Pro'da aynı Apple Hesabı kullanarak mevcut tutun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ các yêu thích của trình xem, yêu thích bài hát, những hình ảnh được tiết kiệm và dự án được tiết kiệm sẵn trên Mac, iPhone, iPad và Apple Vision Pro bằng cách sử dụng cùng một tài khoản Apple."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持视觉化喜欢、歌曲喜爱、保存的外观和保存项目在您的 Mac、iPhone、iPad 和 Apple Vision Pro 上使用相同的 Apple 帐户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持視覺化喜歡、歌曲喜愛、儲存的外觀和儲存專案在您的 Mac、iPhone、iPad 和 Apple Vision Pro 上使用相同的 Apple 帳戶。"
          }
        }
      }
    },
