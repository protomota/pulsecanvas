        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este catálogo de rádio é válido. Escolha um catálogo de versão 1 com URLs de áudio HTTPS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Denna radio katalog är invalid. Välj en version 1 katalog med HTTPS ljudURL."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu radyo kataloğu geçersizdir. HTTPS ses URL'leri ile bir versiyon 1 kataloğu seçin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Danh mục radio này không có hiệu lực.Chọn một thư mục phiên bản 1 với URL âm thanh HTTPS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
