    "Stations couldn't load. Check your connection and try again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stationer kunne ikke lade sig. tjek din forbindelse og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stationen konnten nicht laden. Überprüfen Sie Ihre Verbindung und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las estaciones no pudieron cargar. comprobar su conexión y intentarlo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les stations ne pouvaient pas être chargées. vérifier votre connexion et essayer à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stazioni non potevano caricare. controllare la connessione e provare di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "駅は充電できなかったので、接続をチェックして再度試してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스테이션은 충전 할 수 없었다. 연결을 확인하고 다시 시도하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stasjoner kunne ikke lastes. sjekk koblingen din og prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stations kon niet laden. check your connection and try again."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As estações não poderiam carregar. verificar a sua conexão e tente novamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stationer kunde inte ladda. kontrollera din anslutning och försök igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstasyonlar yüklemeyecek. bağlantınızı kontrol edin ve tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các trạm không thể tải. kiểm tra kết nối của bạn và thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "站不能充电,检查您的连接并尝试一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "站不能充電,檢查您的連線並嘗試一次。"
          }
        }
      }
    },
    "Stations couldn't load. Your local music remains available.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stationer kunne ikke lade op. Din lokale musik forbliver tilgængelig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stationen konnten nicht laden. Ihre lokale Musik bleibt verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las estaciones no pudieron cargar. su música local permanece disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les stations ne pouvaient pas être chargées. votre musique locale reste disponible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stazioni non possono caricare. la tua musica locale rimane disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "駅は充電できなかったので、地元の音楽が残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스테이션은 충전 할 수 없었다.당신의 지역 음악은 여전히 사용할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stasjoner kunne ikke lastes. din lokale musikk er fortsatt tilgjengelig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stations kon niet worden geladen. uw lokale muziek blijft beschikbaar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As estações não poderiam carregar. sua música local permanece disponível."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stationer kunde inte ladda. din lokala musik förblir tillgänglig."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstasyonlar yüklemeyecek. yerel müzikiniz mevcut kalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các trạm không thể tải. âm nhạc địa phương của bạn vẫn còn sẵn dùng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "站不能充电,您的本地音乐仍然可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "站不能充電,您的本地音樂仍然可用。"
          }
        }
      }
    },
