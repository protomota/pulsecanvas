    "See the onboarding again, from the beginning.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se på bordet igen, fra begyndelsen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehen Sie die Bühne wieder, von Anfang an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ver la entrada de nuevo, desde el principio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regardez la route de nouveau, dès le début."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vediamo di nuovo il percorso, dall’inizio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再び、初めから、船の流れを見る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 한번 보세요, 처음부터."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se på nytt, fra begynnelsen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk de opbrengst weer, vanaf het begin."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja a nova linha de navegação, desde o início."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se på ombord igen, från början."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yine bakın, başından beri."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem lại các chuyến bay, từ đầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再看船上,从一开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再看船上,從一開始。"
          }
        }
      }
    },
