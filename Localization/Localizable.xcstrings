    "Forward travel speed. Zero keeps the framing flat.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fremad rejsehastighed.Zero holder rammen flad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortgeschrittenes Reisen: Zero hält den Frameing flach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Velocidad de viaje hacia adelante.Zero mantiene el marco plana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vitesse de voyage en avant: le zéro maintient la plaque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La velocità di viaggio in avanti: zero mantiene la struttura piatta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フロント旅行速度:ゼロはフレームを平らに保ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전선 속도: 0은 층을 유지합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Null holder framover farten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vooruit reizen snelheid.Zero houdt de frame vlak."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A velocidade de viagem para frente. zero mantém o fio plano."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsätt resa hastighet. noll håller framen flat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş hızı: 0'a doğru yolculuk yaptırıyor."
          }
        },
        "vi": {
          "stringUnit": {
