    "Adjust palettes, motion, and Chaos for a different feel.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilpasse paletter, bevægelse og kaos til en anden følelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anpassen von Paletten, Bewegung und Chaos für ein anderes Gefühl."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustar paletas, movimiento y caos para un sentido diferente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuster les palettes, le mouvement et le chaos pour un sentiment différent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Adattare palette, movimento e caos per un senso diverso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パレット、動き、混沌を別の感覚に調整する。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팔레트, 움직임 및 혼란을 다른 느낌으로 조정합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilpasse paletter, bevegelse og kaos for en annen følelse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aanpassen van paletten, beweging en chaos voor een ander gevoel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste paletes, movimento e caos para um sentimento diferente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anpassa paletter, rörelse och kaos för en annan känsla."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paletler, hareket ve kaos farklı bir duygu için ayarlanır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều chỉnh các bảng, động lực và hỗn loạn cho một cảm giác khác nhau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
