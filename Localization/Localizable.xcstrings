    "Fit the visualization to the project’s %@ aspect ratio, with black bars where needed.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilpasse visualisering til projektets %@ aspektforhold, med sorte barer, hvor det er nødvendigt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie die Visualisierung mit dem %@ Aspektverhältnis des Projekts an, wobei bei Bedarf schwarze Baren enthalten sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ajusta la visualización al ratio de aspecto del proyecto %@, con barras negras donde sea necesario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
