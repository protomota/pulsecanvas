    "Pick a fresh visualizer look, or restore a saved favorite": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg en frisk visualiser udseende, eller gendanne en gemt favorit"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie einen frischen Visualisierungsbild aus, oder erholen Sie ein gespeichertes Favorit"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccione un visualización fresca, o restablecer una favorita salvada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un nouveau look visualisateur, ou restaurez un favori sauvé"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un visualizzatore fresco, o ripristinare una preferita salata"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新鮮な視覚化器の表示を選択するか、保存されたお気に入りを復元します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신선한 시각화기를 선택하거나 저장된 좋아하는 것을 복원하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg en fersk visualiser utseende, eller gjenopprette en sparet favoritt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een verse visualiser look, of herstellen van een bewaard favoriet"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma visualização fresca ou restaurar um favorito salvo"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj en färsk visualiseringsbild eller återställa en sparad favorit"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni bir görüntüleyici seçin veya kaydedilen bir favori geri yükleme"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một dạng xem mới, hoặc khôi phục lại một yêu thích được tiết kiệm"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
