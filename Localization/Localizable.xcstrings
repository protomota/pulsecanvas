    "Enjoy your visuals full screen, or export an MP4 with your soundtrack, ready to save and share.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyd dine visuelle fuldskærm, eller eksportere en MP4 med din soundtrack, klar til at gemme og dele."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Genießen Sie Ihre Visualisierungen auf Vollbildschirm oder exportieren Sie eine MP4 mit Ihrem Soundtrack, bereit zu speichern und teilen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Disfruta de tus visuales a pantalla completa, o exporta un MP4 con tu sonido, listo para guardar y compartir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profitez de vos visuels à plein écran, ou exportez un MP4 avec votre sonore, prêt à enregistrer et à partager."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Godetevi le vostre visualizzazioni a schermo pieno, o esportate un MP4 con il vostro soundtrack, pronti per salvare e condividere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全スクリーンビデオを楽しむか、あなたのサウンドトラックでMP4をエクスポートするか、保存し、共有する準備ができています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 화면 시각을 즐기거나, 저장하고 공유 할 준비가되어있는 사운드 트랙과 함께 MP4를 수출하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyt visualiteten din på full skjerm, eller eksportere en MP4 med lydsporene dine, klar til å lagre og dele."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geniet van uw visuals op volledige scherm, of exporteer een MP4 met uw soundtrack, klaar om te slaan en delen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aproveite as suas imagens em tela completa, ou exportar um MP4 com o seu soundtrack, pronto para salvar e compartilhar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Njut av dina visuella fullskärmar, eller exportera en MP4 med din soundtrack, redo att spara och dela."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görüntülerinizin tam ekranını keyfini çıkarın veya bir MP4'ü sesli çubuğunuzla ihraç edin, kaydetmeye ve paylaşmaya hazırsınız."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thưởng thức hình ảnh full screen của bạn, hoặc xuất một MP4 với âm thanh của bạn, sẵn sàng để lưu và chia sẻ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "享受您的全屏视觉,或与您的音频带的MP4出口,准备保存和共享。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "享受您的全屏視覺,或與您的音訊帶的MP4出口,準備儲存和共享。"
          }
        }
      }
    },
