    "Add continuous forward zoom. Zero keeps the framing flat while the visualization continues animating.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero holder rammen flad, mens visualiseringen fortsætter med at animere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero hält die Frame flach, während die Visualisierung weiterhin animiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade continuo zoom hacia adelante.Zero mantiene el marco plana mientras la visualización continúa animando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter un zoom continu en avant.Zero maintient le cadre plat alors que la visualisation continue d'animer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi continuo zoom avanti. Zero mantiene il frame flat mentre la visualizzazione continua ad animare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "継続的な前進ゾームを追加します. Zero はフレームを平らに保ち、視覚化が動作し続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero는 프레임을 평평하게 유지하고 시각화가 계속 동기화됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "0 holder rammen flat mens visualiseringen fortsetter å animere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg continu vooruit zoom toe.Zero houdt de frame vlak terwijl de visualisering blijft animeren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione o zoom contínuo para a frente.Zero mantém o quadro plano enquanto a visualização continua animando."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till kontinuerlig framåt zoom. Zero håller ramverket platt medan visualiseringen fortsätter att animera."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürekli ileriye zoom ekleyin. sıfır çerçeveyi düz tutar, görselleştirme animasyonu devam ederken."
          }
        },
        "vi": {
          "stringUnit": {
