        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizzare preferiti prima, poi visuali non usate della biblioteca. Ogni visualizzatore appare una volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファミリーを使用して、その後未使用の図書館ビデオを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좋아하는 것을 먼저 사용하고, 그 다음에 사용되지 않은 도서관 시각을 사용합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk favoritter først, deretter ubrukte bibliotekvisualer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik eerst favorieten, dan ongebruikt bibliotheekvisuals. elk visualiser verschijnt eenmaal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use preferidos primeiro, depois imagens de biblioteca não usadas. Cada visualizador aparece uma vez."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd favoritbilder först, sedan oanvända bibliotekvisualer. Varje visualiserare visas en gång."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk olarak favori görüntüleri kullanın, sonra kullanılmamış kütüphane görüntüleri."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sử dụng các hình ảnh yêu thích trước, sau đó không sử dụng thư viện. mỗi trình duyệt xuất hiện một lần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首先使用最喜欢的图书馆,然后不使用图书馆视觉,每个视觉显示器都会出现一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "首先使用最喜歡的圖書館,然後不使用圖書館視覺,每個視覺顯示器都會出現一次。"
          }
        }
      }
    },
    "Use only your visualizer pool. Small pools repeat to fill the timeline.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug kun din visualiseringspool. små pooler gentage for at fylde timeline."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie nur Ihren Visualisierungspool. kleine Pools wiederholen, um die Zeitraumlinie zu füllen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sólo use su piscina de visualización. pequeñas piscinas repiten para llenar la línea horaria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez uniquement votre piscine visualisateur. petites piscines répètent pour remplir la ligne de temps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizzare solo la piscina visualizzatore. piccoli piscini ripetono per riempire il timeline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビューリッジプールのみを使用します 小さなプールはタイムラインを満たすために繰り返します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시각화 수영장만 사용하십시오.작은 수영장은 시간표를 채우기 위해 반복됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk bare visualiserings bassenget ditt. små bassenger gjentar for å fylle timelinjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik alleen uw visualiserpool. kleine zwembaden herhalen om de timeline te vullen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use apenas a piscina de visualização. pequenas piscinas repitam para preencher o horário."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd bara din visualiseringspool. små pooler upprepa för att fylla i timeline."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sadece görsellerinizin havuzunu kullanın. küçük havuzlar zaman çizgisini doldurmak için tekrarlanır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ sử dụng hồ bơi hiển thị của bạn. hồ bơi nhỏ lặp lại để điền vào dòng thời gian."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只使用您的视觉游泳池. 小游泳池重复填写时间表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只使用您的視覺游泳池. 小游泳池重複填寫時間表。"
          }
        }
      }
    },
