    "Music into moving visuals. Free to use, with no account or subscription.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Musik til bevægelige visualer. Gratis at bruge, uden konto eller abonnement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Musik in bewegende Visuals. kostenlos zu verwenden, ohne Konto oder Abonnement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Música en visual movimiento. libre de usar, sin cuenta ni suscripción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Musique dans les visuels en mouvement. gratuit à utiliser, sans compte ni abonnement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Music in visuali mobili. libero da usare, senza account o abbonamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音楽を動くビジュアルに送信します. アカウントやサブスクリプションなしで無料で使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음악을 이동 시각으로. 무료로 사용, 계정이나 구독이 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
