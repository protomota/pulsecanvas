    "Browse categories and heart the looks you love.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se kategorier og hjerte, du ser godt ud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Browse Kategorien und Herz das aussieht, was du liebst."
