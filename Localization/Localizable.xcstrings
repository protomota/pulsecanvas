    "Higher sensitivity includes softer hi-hat hits.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Højere følsomhed omfatter blødere hi-hat hits."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höhere Empfindlichkeit beinhaltet weichere Hi-Hat-Hits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sensibilidad superior incluye los hits de hi-hat más suaves."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une plus grande sensibilité comprend des hits plus doux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sensibilità maggiore include i hit più sottili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "より高い敏感性には、より柔らかいヒットが含まれています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 높은 민감성에는 얇은 hi-hat 히트가 포함됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Høyere følsomhet inkluderer mildere hi-hat hits."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoger gevoeligheid omvat zachter hi-hat hits."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A maior sensibilidade inclui hits mais suaves de hi-hat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Högre känslighet inkluderar mildare hi-hat hits."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha yüksek hassasiyet, daha yumuşak hi-hat hitleri içerir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Độ nhạy cao hơn bao gồm các cú hi-hat nhẹ hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更高的敏感性包括较软的hi-hat 击。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更高的敏感性包括較軟的hi-hat 擊。"
          }
        }
      }
    },
