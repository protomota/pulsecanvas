    "iCloud Drive is unavailable. Sign in to iCloud and use an iCloud-enabled signed build. Your local data is safe.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive er ikke tilgængelig. log ind på iCloud og brug en iCloud -enabled signatur bygning. dine lokale data er sikre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive ist nicht verfügbar. Anmeldung zu iCloud und verwenden Sie eine iCloud -fähige unterschriebene Bau. Ihre lokalen Daten sind sicher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive no está disponible.Sincribe en iCloud y use un iCloud -activado firmado construcción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive est inaccessible.Sign dans iCloud et utilisez un bâtiment signé iCloud -activé.Vous les données locales sont sécurisées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive non è disponibile. iscriviti a iCloud e utilizzi un iCloud -inabled firmato build. i tuoi dati locali sono sicuri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive は利用できません. iCloud にサインインして iCloud - が有効で署名された構築を使用してください. あなたの地元のデータは安全です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive는 사용할 수 없습니다.iCloud에 로그인하고 iCloud - 활성화 서명 구축을 사용하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive er ikke tilgjengelig. logg inn på iCloud og bruk en iCloud -aktivert signert bygning. dine lokale data er trygge."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive is niet beschikbaar. log in op iCloud en gebruik een iCloud -geleverd ondertekend gebouw. uw lokale gegevens zijn veilig."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive não está disponível. Inscreva-se em iCloud e use um iCloud -activado assinado build."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive är inte tillgänglig. logga in på iCloud och använd en iCloud -tillåtet signaturbyggnad. dina lokala data är säkra."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive kullanılamaz. iCloud'ye giriş yapın ve bir iCloud -bilinmiş imzalanmış yapı kullanın. yerel verileriniz güvenlidir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive không sẵn dùng. đăng nhập vào iCloud và sử dụng một iCloud -tính năng ký kết xây dựng. dữ liệu địa phương của bạn an toàn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive 无法使用. 登录到 iCloud 并使用一个 iCloud - 启用签名构建。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive 無法使用. 登入到 iCloud 並使用一個 iCloud - 啟用簽名構建。"
          }
        }
      }
