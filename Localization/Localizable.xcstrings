    "Backups include personal music files. Store them somewhere private.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups indeholder personlige musikfiler. lagre dem et sted privat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups enthalten persönliche Musikdateien. Speichern Sie sie irgendwo privat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las backups incluyen archivos de música personales. almacenarlos en algún lugar privado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sauvegardes comprennent des fichiers de musique personnels. les stocker quelque part privés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I backup includono file musicali personali. memorizzati in un luogo privato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップには、個人的な音楽ファイルが含まれています. どこかでプライベートに保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업에는 개인 음악 파일이 포함되어 있습니다.그것들을 개인적으로 저장합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups inkluderer personlige musikkfiler. lagre dem noe privat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups bevatten persoonlijke muziekbestanden. ze opslaan ergens privé."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As backups incluem arquivos de música pessoais. armazená-los em algum lugar privado."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups innehåller personliga musikfiler. lagra dem någonstans privat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedekleme kişisel müzik dosyaları içerir. onları özel bir yerde saklayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các sao lưu bao gồm các tập tin âm nhạc cá nhân. lưu trữ chúng ở một nơi nào đó riêng tư."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份包括个人音乐文件,存储在某个地方私人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備份包括個人音樂檔案,儲存在某個地方私人。"
          }
        }
      }
    },
