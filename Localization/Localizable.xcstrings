    "120 fps renders twice as many frames as 60 fps. Export times and playback support vary.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "120 fps giver to gange så mange rammer som 60 fps. Eksporttider og playback support varierer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "120 fps rendiert doppelt so viele Frame wie 60 fps. Exportzeiten und Playback-Support variieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "120 fps rendirá dos veces más cuadros que 60 fps. tiempos de exportación y soporte de reproducción varían."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "120 fps rend deux fois plus de cadres que 60 fps. temps d'exportation et support de reprise varient."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "120 fps rendisce il doppio di più frame di 60 fps. Tempo di esportazione e supporto riproduzione variano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "120fpsは60fpsのフレームの2倍を返します 輸出時間と再生サポートが異なります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "120 fps는 60 fps만큼의 프레임을 두 배로 던지며 수출 시간과 재생 지원이 다릅니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "120 fps gir to ganger så mange rammer som 60 fps. Eksporttid og spillback-støtte varierer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "120 fps rendert twee keer zoveel ramen als 60 fps. Exporttijden en playback ondersteuning variëren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "120 fps rendem duas vezes mais quadros do que 60 fps. tempos de exportação e suporte para reprodução variam."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "120 fps ger dubbelt så många rammar som 60 fps. Exporttider och spelläggstöd varierar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "120 fps 60 fps kadar çerçeve iki katını verir. ihracat zamanları ve oynatma desteği değişir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "120 fps render hai lần nhiều khung như 60 fps. thời gian xuất khẩu và hỗ trợ quay lại khác nhau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "120fps 返回的框架数量为 60fps 的两倍,出口时间和播放支持不同。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "120fps 返回的框架數量為 60fps 的兩倍,出口時間和播放支援不同。"
          }
        }
      }
    },
