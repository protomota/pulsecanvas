    "Choose music or import a soundtrack. Studio finds the beat so your scenes can change with the song.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg musik eller import en soundtrack. Studio finder beat, så dine scener kan ændre sig med sangen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie Musik oder importieren Sie eine Soundtrack. Studio findet den Schlag, so dass sich Ihre Szenen mit dem Song ändern können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccione música o importar una banda sonora. Studio encuentra el golpe para que sus escenas puedan cambiar con la canción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la musique ou importez un soundtrack. Studio trouve le bite afin que vos scènes puissent changer avec la chanson."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli musica o importati un soundtrack. Studio trova il battito in modo che le tue scene possano cambiare con la canzone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音楽を選択するか、サウンドトラックをインポートします. スタジオはビットを見つけますので、あなたのシーンは曲とともに変更することができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음악을 선택하거나 사운드 트랙을 가져오십시오. 스튜디오는 흔들림을 찾으므로 장면이 노래와 함께 변경될 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg musikk eller import en soundtrack. Studio finner beat slik at scener kan endre seg med sangen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies muziek of import een soundtrack. Studio vindt de beat zodat uw scènes kunnen veranderen met het lied."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha música ou importar uma faixa de som. o estúdio encontra a batida para que suas cenas possam mudar com a canção."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj musik eller import en soundtrack. Studio hittar slaget så att dina scener kan ändras med låten."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Müzik seçin veya bir sesli çubuğu ithal edin.Studio, şarkı ile sahneleriniz değişebilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn âm nhạc hoặc nhập một soundtrack. Studio tìm thấy nhịp để cảnh của bạn có thể thay đổi với bài hát."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择音乐或进口音频轨道. Studio 会找到打击,以便您的场景可以与歌曲一起改变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇音樂或進口音訊軌道. Studio 會找到打擊,以便您的場景可以與歌曲一起改變。"
          }
        }
      }
    },
