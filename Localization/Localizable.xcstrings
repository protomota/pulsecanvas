          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours facultatif. trouver sur-boarding et soutien à nouveau dans les paramètres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre opzionale. trovare il supporto e l'applicazione di nuovo nelle Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常にオプションです. 再度設定で上着とサポートを検索します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항상 선택적입니다.Settings에서 다시 탑승 및 지원을 찾으십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alltid valgfritt. Finn på bord og støtte igjen i Innstillinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Altijd optioneel. vind opboord en ondersteuning weer in Settings."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre opcional. encontrar o suporte e a navegação novamente em Settings."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alltid valfritt. hitta onboarding och stöd igen i Inställningar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her zaman seçmeli. Settings'te yeniden yükleme ve destek bul."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luôn luôn tùy chọn. tìm lại việc trên và hỗ trợ một lần nữa trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "始终可选. 在 Settings 中重新找到登机和支持。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "始終可選. 在 Settings 中重新找到登機和支援。"
          }
        }
      }
    },
