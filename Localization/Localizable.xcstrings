    "Fresh looks replace visual settings. Timing and soundtrack stay.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fresh look erstattes af visuelle indstillinger. timing og soundtrack ophold."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frisch ersetzt visuelle Einstellungen. Timing und Soundtrack bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El aspecto fresco sustituye las configuraciones visuales. tiempo y soundtrack permanece."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'apparence fraîche remplacera les paramètres visuels. le temps et la sonde demeure."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'aspetto fresco sostituisce le impostazioni visive. tempo e soundtrack rimanere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フレッシュな外観は視覚設定を置き換え、タイミングとサウンドトラックの滞在。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신선한 외관은 시각 설정을 대체합니다. 타이밍 및 사운드 트랙이 남아 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fresh look erstattes av visuelle innstillinger. Timing og soundtrack stop."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fresh look vervangt visuele instellingen. timing en soundtrack verblijf."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A aparência fresca substitui as configurações visuais. tempo e soundtrack permanecer."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Färskt utseende ersätter visuella inställningar. Timing och soundtrack stanna."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fresh look, görsel ayarları değiştirir. zamanlama ve sesli iz kalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tương tự tươi thay thế cài đặt thị giác. thời gian và soundtrack stay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新鲜的外观取代视觉设置,时间和音频轨道保持。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新鮮的外觀取代視覺設定,時間和音訊軌道保持。"
          }
        }
      }
    },
