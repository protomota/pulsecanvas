    "Zero turns off music response while smooth visualization motion and zoom continue. Increase for beat-driven waves, local swelling, liquid deformation, and motion.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero afbryder musikresponsen, mens glat visualisering bevægelse og zoom fortsætter. Øget for slag-drivet bølger, lokal opbløffelse, væske deformation og bevægelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero ruft die Musikantworten ab, während die glatte Visualisierung Bewegung und Zoom fortgesetzt. Erhöhen für Schlagdriv-Wellen, lokalen Aufwärmung, Flüssigkeit Deformation und Bewegung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero desvia la respuesta de la música mientras el movimiento y zoom de visualización suaves continúan. Increase para ondas impulsadas por golpe, inchaço local, deformación líquida y movimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero détourne la réponse musicale tandis que le mouvement de visualisation et le zoom continuent. Augmentation pour les vagues à l'encontre, l'inflammation locale, la déformation liquide et le mouvement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero spinge la risposta musicale mentre il movimento di visualizzazione e lo zoom continuano. Aumento per onde a battaglia, gonfiore locale, deformazione liquida e movimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゼロは音楽反応を停止し、柔らかい視覚化動きとゾームが続く。 衝撃による波、地元の腫れ、液体変形、および動きのために増加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero는 음악 반응을 끄고, 부드러운 시각화 움직임과 zoom이 계속됩니다. beat-driven 파도, 지역 팽창, 액체 변형 및 움직임에 대한 증가."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero avbryter musikkresponsen mens glat visualisering bevegelse og zoom fortsetter. øke for beat-driven bølger, lokal oppblåsthet, væske deformasjon, og bevegelse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero schakelt de muziekrespons af terwijl gladde visualisatie beweging en zoom voortdurend. Verhoog voor beat-driven golven, lokale zwelling, vloeibare vervorming, en beweging."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero desvia a resposta da música enquanto o movimento de visualização suave e zoom continuam. aumento para ondas impulsionadas por batidas, inchaço local, deformação líquida e movimento."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero avbryter musikresponsen medan smidiga visualisering rörelse och zoom fortsätter. Öka för beat-driven vågor, lokal svullnad, flytande deformation och rörelse."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero, ses tepkisini yumuşak görüntü hareketleri ve zoom devam ederken devre dışı bırakır. vurgu dalgaları, yerel şişlikler, sıvı deformasyonlar ve hareket için artış."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero xoay phản ứng âm nhạc trong khi chuyển động hình ảnh và zoom tiếp tục. tăng cho sóng dẫn đến đánh, viêm địa phương, biến dạng chất lỏng và chuyển động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "零将音乐反应中断,而顺利的视觉化运动和振动继续;加剧由打导波、局部肿胀、液体变形和运动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "零將音樂反應中斷,而順利的視覺化運動和振動繼續;加劇由打導波、區域性腫脹、液體變形和運動。"
          }
        }
      }
    },
