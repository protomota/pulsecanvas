    "Flashes follow hi-hat attacks. Zero Chaos keeps flashes off.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flashes følger hi-hat angreb. Zero Chaos holder flashes væk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flashes folgen hi-hat Angriffe.Zero Chaos hält die Blitzes ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flashes sigue los ataques de hi-hat.Zero Chaos mantiene los flashes desactivados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les flashes suivent les attaques hi-hat.Zero Chaos maintient les flashes hors."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Flashes seguono gli attacchi di hi-hat. Zero Chaos mantiene i flashes fuori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フラッシュはハイハット攻撃を追跡します. Zero Chaos はフラッシュを止めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플래시가 하이하트 공격을 따르고, Zero Chaos는 플래시를 끄는 것을 유지합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flashes følger hi-hat angrep. Zero Chaos holder flashes av."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Flashes volgen hi-hat aanvallen. Zero Chaos houdt flashes af."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Flashes seguem ataques de hi-hat. zero caos mantém flashes off."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flashes följer hi-hat attacker. Zero Chaos håller flashes av."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flashes Hi-hat saldırılarını takip eder. Zero Chaos flashes'i kapatır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Flashes theo các cuộc tấn công hi-hat. Zero Chaos giữ flashes off."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "闪光跟随Hi-hat攻击,零混乱保持闪光。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "閃光跟隨Hi-hat攻擊,零混亂保持閃光。"
          }
        }
      }
    },
