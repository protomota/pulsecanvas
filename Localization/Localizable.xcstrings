    "Select this section; keep playing if playback is running, or preview while paused": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg denne sektion; fortsæt med at spille, hvis playback er i gang, eller forudsige under pause"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie diesen Abschnitt aus; spielen Sie weiter, wenn das Playback laufen wird oder während des Pauses vorsehen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccione esta sección; continúe jugando si se está haciendo el playback, o preview mientras se ha descansado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez cette section; continuer à jouer si le playback est en cours, ou prévoir pendant la pause"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Selezionare questa sezione; continuare a giocare se il ripristino è in esecuzione, o preview mentre si è sospeso"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセクションを選択し、再生が実行されている場合にプレイを続けるか、休憩中にプレビューするか。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 섹션을 선택하십시오; 재생이 실행되면 계속 재생하거나 휴식 중 예보"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg denne delen; fortsett å spille hvis spillingen er i gang, eller forhåndsvisning mens du har pause"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer deze sectie; blijven spelen als de playback wordt uitgevoerd, of voorzien tijdens een pauze"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione esta seção; continue a jogar se o playback estiver em andamento, ou prevê enquanto descansado"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj den här sektionen; fortsätta spela om spelet är igång, eller förhandsvisar under paus"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bölümü seçin; oynamaya devam ederseniz, veya duraklama sırasında önizleme"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn phần này; tiếp tục chơi nếu playback đang chạy, hoặc xem trước khi nghỉ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择此部分;如果播放正在运行,继续播放,或在休息期间预览"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇此部分;如果播放正在執行,繼續播放,或在休息期間預覽"
          }
        }
      }
    },
