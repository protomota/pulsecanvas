    "No playable songs found. Use MP3, M4A, WAV, AIFF, AAC, CAF or FLAC files up to 100 MB and two hours each.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug MP3, M4A, WAV, AIFF, AAC, CAF eller FLAC filer op til 100 MB og to timer hver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurden keine Playable Songs gefunden. Verwenden Sie MP3, M4A, WAV, AIFF, AAC, CAF oder FLAC Dateien bis zu 100 MB und zwei Stunden jeweils."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron canciones reproducibles. Utilice archivos MP3, M4A, WAV, AIFF, AAC, CAF o FLAC hasta 100 MB y dos horas cada uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez des fichiers MP3, M4A, WAV, AIFF, AAC, CAF ou FLAC jusqu'à 100 MB et deux heures chacune."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sono state trovate canzoni da riprodurre. utilizzare file MP3, M4A, WAV, AIFF, AAC, CAF o FLAC fino a 100 MB e due ore ciascuno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MP3、M4A、WAV、AIFF、AC、CAFまたはFLACファイルを最大100MBまで使用し、2時間ごとに使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MP3, M4A, WAV, AIFF, AAC, CAF 또는 FLAC 파일을 최대 100MB까지 사용하고 각각 2시간."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke funnet spillbare sanger. Bruk MP3, M4A, WAV, AIFF, AAC, CAF eller FLAC filer opptil 100 MB og to timer hver."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik MP3, M4A, WAV, AIFF, AAC, CAF of FLAC bestanden tot 100 MB en twee uur elk."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não encontraram músicas reproduzíveis. Use arquivos MP3, M4A, WAV, AIFF, AAC, CAF ou FLAC até 100 MB e duas horas cada."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga spelasändningar hittades. Använd MP3, M4A, WAV, AIFF, AAC, CAF eller FLAC filer upp till 100 MB och två timmar vardera."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MP3, M4A, WAV, AIFF, AAC, CAF veya FLAC dosyalarını 100 MB'a kadar ve her biri iki saat boyunca kullanın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy bài hát chơi được. Sử dụng MP3, M4A, WAV, AIFF, AAC, CAF hoặc FLAC tệp lên đến 100 MB và hai giờ mỗi."
          }
        },
        "zh-Hans": {
