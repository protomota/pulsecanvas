    "Thank you for supporting development.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak for at støtte udviklingen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke für die Unterstützung der Entwicklung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gracias por apoyar el desarrollo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci pour le soutien au développement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grazie per il sostegno allo sviluppo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開発を支援してくれてありがとう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개발을 지원해 주셔서 감사합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Takk for at du støtter utviklingen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dank je wel voor de steun van ontwikkeling."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrigado por apoiar o desenvolvimento."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tack för att du stöder utvecklingen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelişmeyi destekleyen için teşekkür ederiz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cảm ơn bạn đã hỗ trợ phát triển."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "感谢支持发展。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "感謝支援發展。"
          }
        }
      }
    },
    "Thank you for supporting development. You’re all set—no further action is needed.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak for at du støtter udviklingen.Du er alle indstillet – der er ingen yderligere handlinger nødvendige."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke für die Unterstützung der Entwicklung. Sie sind alle bereit – keine weiteren Aktionen benötigt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gracias por apoyar el desarrollo.Todos están preparados - no se necesita más acción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci pour votre soutien au développement. Vous êtes tous fixés - aucune action supplémentaire n'est nécessaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grazie per il sostegno allo sviluppo.Siete tutti impostati - non è necessaria ulteriore azione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開発をサポートしてくれてありがとう!皆、準備が整った――さらなる行動は必要ありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개발 지원에 감사드립니다.당신은 모두 정해져 있습니다-다음 행동이 필요하지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Takk for at du støtter utviklingen.Du er alle satt - ingen ytterligere handling er nødvendig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dank je voor de ondersteuning van ontwikkeling.Jullie zijn allemaal ingesteld – geen verdere actie is nodig."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrigado por apoiar o desenvolvimento.Você está tudo pronto - não é necessário mais ação."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tack för att du stöder utvecklingen.Du är alla inställd – ingen ytterligare åtgärd behövs."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm gelişmeleri desteklediğiniz için teşekkür ederiz.Hepiniz ayarlanmışsınız - daha fazla eylem gerekmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cảm ơn bạn đã hỗ trợ phát triển. tất cả các bạn đều sẵn sàng - không cần hành động thêm nữa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "感谢支持发展,你们都准备好了,不需要进一步行动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "感謝支援發展,你們都準備好了,不需要進一步行動。"
          }
        }
      }
    },
