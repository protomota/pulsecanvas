    },
    "This preset supplies its own colors, shapes, waves, and feedback. Adjust motion and audio response below.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne præstation leverer sine egne farver, former, bølger og feedback. justere bevægelse og lydrespons nedenfor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Vorlage bietet ihre eigenen Farben, Formen, Wellen und Feedback. Bearbeiten Bewegung und Audio-Reaktion unten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este preset proporciona sus propias colores, formas, ondas y comentarios. ajustar la respuesta de movimiento y audio a continuación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce prédécesseur fournit ses propres couleurs, formes, ondes et commentaires. ajuster la réponse de mouvement et son ci-dessous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo presetto fornisce i suoi colori, forme, onde e feedback."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプレセットは、独自の色、形状、波、およびフィードバックを提供します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프레세트는 자신의 색상, 모양, 파도 및 피드백을 제공합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne forhåndsinnstillingen gir sine egne farger, former, bølger og tilbakemeldinger. justere bevegelse og lydrespons nedenfor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze preset levert zijn eigen kleuren, vormen, golven en feedback."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este pré-sete fornece suas próprias cores, formas, ondas e feedback. ajustar a resposta de movimento e áudio abaixo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Denna preset ger sina egna färger, former, vågor och feedback. justera rörelse och ljudrespons nedan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ön ayar kendi renkleri, şekilleri, dalga ve geribildirim sağlar. hareket ve ses yanıtını aşağıda ayarlayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết lập trước này cung cấp màu sắc, hình dạng, sóng và phản hồi riêng của nó. điều chỉnh chuyển động và phản ứng âm thanh bên dưới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此前置提供自己的颜色,形状,波浪和反馈。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此前置提供自己的顏色,形狀,波浪和反饋。"
          }
        }
      }
    },
    "This radio catalog is invalid. Choose a version 1 catalog with HTTPS audio URLs.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne radio katalog er ugyldig.Vælg en version 1 katalog med HTTPS audio URL'er."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Radio-Katalog ist nicht gültig. Wählen Sie einen Version 1 Katalog mit HTTPS Audio-URLs aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este catálogo de radio es invalido. escoge un catálogo de versión 1 con URLs de audio HTTPS."
          }
        },
        "fr": {
