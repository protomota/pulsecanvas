          }
        }
      }
    },
    "This removes it from the synced project list on all devices. Existing local project and audio files are kept.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner det fra den synkroniserede projektliste på alle enheder. eksisterende lokale projekter og lydfiler bevares."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies entfernt es aus der synchronisierten Projektliste auf allen Geräten. bestehende lokale Projekte und Audio-Dateien werden gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto lo remove de la lista de proyectos sincronizados en todos los dispositivos. se mantienen archivos de proyecto y audio locales existentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela le supprime de la liste synchronisée des projets sur tous les appareils. Les fichiers locaux existants et audio sont conservés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo lo rimuove dalla lista di progetti sincronizzati su tutti i dispositivi. sono conservati i file di progetto locale e audio esistenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、すべてのデバイス上の合成プロジェクトリストから削除されます 既存の地元プロジェクトおよびオーディオファイルが保存されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 모든 장치에서 합성 프로젝트 목록에서 제거합니다.현재의 지역 프로젝트 및 오디오 파일이 보관됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner det fra synkroniserte prosjektlisten på alle enheter. eksisterende lokale prosjekter og lydfiler blir holdt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit verwijdert het uit de synchroniseerde projectlijst op alle apparaten. bestaande lokale projecten en audio-bestanden worden bewaard."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remove-o da lista de projetos sincronizados em todos os dispositivos. arquivos de projeto local e áudio existentes são mantidos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta tar bort det från den synkroniserade projektlistan på alla enheter. befintliga lokala projekt och ljudfiler sparas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, tüm cihazlarda senkronize proje listesinden çıkarılır. mevcut yerel proje ve ses dosyaları saklanır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều này loại bỏ nó khỏi danh sách dự án đồng bộ trên tất cả các thiết bị. dự án địa phương hiện có và tệp âm thanh được giữ lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此将其从所有设备上的合成项目列表中删除,现有本地项目和音频文件保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此將其從所有裝置上的合成專案列表中刪除,現有本地專案和音訊檔案保留。"
          }
        }
      }
    },
    "This replaces the app’s saved data and preferences with the backup after you close and reopen PulseCanvas. Existing project files outside the app remain unchanged. Export a current backup first if you want to keep both.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette erstattes appens gemte data og præferencer med sikkerhedskopieringen efter at du lukker og genåbner PulseCanvas. eksisterende projektfiler uden for appen forbliver uændret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ersetzt die gespeicherten Daten und Vorlieben der App mit dem Backup, nachdem Sie PulseCanvas schließen und wieder öffnen. bestehende Projektdateien außerhalb der App bleiben unverändert. Exportieren Sie zunächst eine aktuelle Backup, wenn Sie beide halten möchten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto reemplaza los datos y preferencias almacenados de la aplicación con la copia de seguridad después de cerrar y reabrir PulseCanvas. Los archivos de proyecto existentes fuera de la app permanecen inalterados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela remplace les données et préférences sauvegardées de l'application avec la sauvegarde après que vous fermez et réouvertez PulseCanvas. Les fichiers de projet existants en dehors de l'application restent inchangés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo sostituisce i dati e le preferenze salvati dell'app con la backup dopo aver chiuso e riaperto PulseCanvas. I file di progetto esistenti al di fuori dell'app rimangono invariati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは、アプリの保存されたデータと好みをバックアップで置き換え、PulseCanvas を閉じ、再開した後にバックアップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱의 저장된 데이터와 선호도를 잠그고 다시 열면 백업으로 대체합니다.PulseCanvas. 앱 밖의 기존 프로젝트 파일은 변하지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette erstattes av appen lagrede data og preferanser med sikkerhetskopien etter at du lukker og åpner PulseCanvas. eksisterende prosjektfiler utenfor appen forblir uendret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit vervangt de opgeslagen gegevens en voorkeuren van de app met de back-up na het sluiten en openen van PulseCanvas. bestaande projectbestanden buiten de app blijven onveranderd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso substitui os dados e preferências salvos da aplicação com a backup após fechar e reabrir PulseCanvas. arquivos de projeto existentes fora da aplicação permanecem inalterados."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta ersätter appen lagrade data och preferenser med säkerhetskopiering efter att du stänger och öppnar igen PulseCanvas. Existerande projektfiler utanför appen förblir oförändrade."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, uygulamanın kaydedilen verileri ve tercihlerini kapatıldıktan sonra yedekleme ile değiştirir ve PulseCanvas'yi yeniden açtığınızda. uygulamanın dışındaki mevcut proje dosyaları değişmez kalır. her ikisini de tutmak istiyorsanız, bir önceki yedeklemeyi ihraç edin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều này thay thế dữ liệu và sở thích được lưu trữ của ứng dụng bằng sao lưu sau khi bạn đóng lại và mở lại PulseCanvas. Các tệp dự án hiện có bên ngoài ứng dụng vẫn không thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此取代了应用程序保存的数据和偏好,并在您关闭并重新打开后备份 PulseCanvas. 应用程序以外的现有项目文件仍然不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此取代了應用程式儲存的資料和偏好,並在您關閉並重新開啟後備份 PulseCanvas. 應用程式以外的現有專案檔案仍然不變。"
          }
        }
      }
    },
    "This replaces the chosen visualizers or scene lengths throughout your Studio timeline.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette erstattes af de valgte visualisatorer eller scenelængder i hele dit Studio-tidslinje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ersetzt die gewählten Visualisatoren oder Szenenlängen während der Studio-Timeline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto sustituye los visualizadores o longitudes de escena elegidos a lo largo de su horario Studio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela remplacera les visualisateurs ou longues scènes choisis tout au long de votre timeline Studio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo sostituisce i visualizzatori o lunghezze di scena scelti nel corso del tuo calendario Studio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは、スタジオタイムライン全体で選択した視聴器やシーン長さを置き換えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업은 Studio 타임 라인 내에서 선택한 시각화 또는 장면 길이를 대체합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette erstattes av de valgte visualisatorene eller scenes lengder i hele Studio-tidslinjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit vervangt de geselecteerde visualisatoren of scenen lengtes gedurende uw Studio timeline."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso substitui os visualizadores escolhidos ou as longitudes de cena ao longo da sua linha de tempo do Studio."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta ersätter de valda visualiserare eller scenskängderna under hela din Studio-tidslinje."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, seçilen görüntüleme veya sahne uzunluklarını Studio zaman çizgisinde değiştirir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều này thay thế các trình chiếu hoặc chiều dài cảnh được chọn trong suốt thời gian Studio của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它将取代您选择的视觉或场景长度,在您的 Studio 时间表中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它將取代您選擇的視覺或場景長度,在您的 Studio 時間表中。"
          }
        }
      }
    },
